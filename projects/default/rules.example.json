{
  "schema_version": 1,
  "throttle": "off",
  "throttle_match": ".",
  "loss": 0,
  "tls": {"mode": "all", "allow": [], "ignore": []},
  "manual": {
    "latency_ms": 0,
    "jitter_ms": 0,
    "down_kbps": 0,
    "up_kbps": 0,
    "loss_pct": 0,
    "response_delay_ms": 0
  },
  "rules": [],
  "scripts": [],
  "breakpoints": [],
  "collections": {
    "recording": null,
    "record_match": ".",
    "replay": [],
    "strict": false
  },
  "rule_examples": [
    {
      "name": "example-header",
      "enabled": false,
      "match": "example\\.test",
      "action": "set_header",
      "side": "request",
      "header": "X-Debug",
      "value": "1"
    },
    {
      "name": "example-json",
      "enabled": false,
      "match": "example\\.test",
      "action": "json_patch",
      "set": {
        "debug": true
      }
    },
    {
      "name": "example-remote",
      "enabled": false,
      "match": "example\\.test",
      "action": "map_remote",
      "replace": "^https://example\\.test/",
      "with": "https://staging.example.test/"
    }
  ]
}
