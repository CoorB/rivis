# mock NAME URL-REGEX — Proxyman's "right-click → Map Local": take the newest captured call
# matching the regex, save its real response body to a file, and serve that file from now on.
cmd_mock() {
  [ $# -eq 2 ] || die "usage: $CLI mock NAME URL-REGEX   (run the journey once first so the call is captured)"
  safe_name "$1"     # F-17: before anything is written under mocks/
  ensure_rules
  [ -n "$(port_owner "$WEB_PORT")" ] || die "mitmweb is not running — $CLI start"
  local tmp; tmp=$(mktemp); ui_curl /flows > "$tmp" \
    || { rm -f "$tmp"; die "could not read the captured calls"; }
  local pick; pick=$(/usr/bin/python3 -I "$SCRIPT_DIR/addons/rules_cli.py" "$RULES" mock-pick "$1" "$2" "$tmp") || { rm -f "$tmp"; exit 1; }
  rm -f "$tmp"
  local id status method headers; { read -r id; read -r status; read -r method; read -r headers; } <<< "$pick"
  mkdir -p "$PROJECT_STATE/mocks" || die "could not save the response body: cannot create the mocks folder"
  local file="$PROJECT_STATE/mocks/$1.json" body_tmp curl_rc=0
  body_tmp=$(mktemp "$PROJECT_STATE/mocks/.$1.XXXXXX") || die "could not save the response body: mocks folder is not writable"
  ui_curl "/flows/$id/response/content.data" -o "$body_tmp" || curl_rc=$?
  if [ "$curl_rc" -ne 0 ]; then
    rm -f "$body_tmp"
    [ "$curl_rc" -eq 23 ] && die "could not save the response body: write failed (check project folder and free space)"
    die "could not read the response body (curl exit $curl_rc)"
  fi
  /usr/bin/python3 -I -c 'import json,sys; json.load(open(sys.argv[1]))' "$body_tmp" 2>/dev/null \
    || file="${file%.json}.txt"
  local created_mock=1
  [ -e "$file" ] && created_mock=0
  mv -f "$body_tmp" "$file" || { rm -f "$body_tmp"; die "could not save the response body: project folder is not writable"; }
  RIVIS_RULE_CONFDIR="$CONFDIR" /usr/bin/python3 -I "$SCRIPT_DIR/addons/rules_cli.py" "$RULES" rules mock-set "$1" "match=$2" action=map_local \
    "file=$file" "status=$status" "method=$method" "headers=$headers" "created_mock=$created_mock" || exit 1
  info "saved the real $method response ($status) to $file"
  info "map_local rule '$1' is ON — edit that file; every save applies to the next call"
  info "turn off: $CLI rules off $1"
}

cmd_rules()    { ensure_rules; warn_running_project; RIVIS_ACTIVE_PROJECT="$PROJECT" RIVIS_RULE_CONFDIR="$CONFDIR" /usr/bin/python3 -I "$SCRIPT_DIR/addons/rules_cli.py" "$RULES" rules "$@"; } # R5A-02: same file guard as proxy load
