# ───────────────────────── android ─────────────────────────
pick_serial() {
  local s devices q1 q2
  if [ -n "${SERIAL:-}" ]; then s="$SERIAL"
  else
    devices=$("$ADB" devices) || die "adb devices failed"
    s=$(printf '%s\n' "$devices" | awk '/^emulator-[0-9]+\tdevice$/{print $1}')
  fi
  [ -z "$s" ] && die "no running emulator (adb devices). Physical devices need a separate approval."
  [ "$(echo "$s" | wc -l | tr -d ' ')" -gt 1 ] && die "several emulators running — pass -s SERIAL: $(echo $s)"
  [[ "$s" =~ ^emulator-[0-9]+$ ]] || die "physical devices need a separate approval"
  q1=$("$ADB" -s "$s" shell getprop ro.kernel.qemu 2>/dev/null | tr -d '\r') || die "$s: could not verify emulator status"
  q2=$("$ADB" -s "$s" shell getprop ro.boot.qemu 2>/dev/null | tr -d '\r') || die "$s: could not verify emulator status"
  [ "$q1" = 1 ] || [ "$q2" = 1 ] || die "physical devices need a separate approval"
  echo "$s"
}

have_root() { [ "$("$ADB" -s "$1" shell id -u 2>/dev/null | tr -d '\r')" = "0" ]; }

# Tap the first on-screen node whose text/content-desc matches the regex (scrolls if needed).
# Drives the Settings CA screens on Google Play images, where `adb root` is refused.
# English UI labels; on mismatch the caller falls back to printed manual steps.
ui_tap() {   # ui_tap SERIAL REGEX [N] — tap the Nth match (default 1st)
  local s="$1" re="$2" nth="${3:-1}" b i xml prev=""
  [ -n "${SCREEN_H:-}" ] || SCREEN_H=$("$ADB" -s "$s" shell wm size | tr -d '\r' | awk -F'[x ]' '/size/{print $NF}')
  for i in $(seq 1 12); do
    "$ADB" -s "$s" shell uiautomator dump /sdcard/proxy-ui.xml >/dev/null 2>&1
    xml=$("$ADB" -s "$s" shell cat /sdcard/proxy-ui.xml 2>/dev/null)
    b=$(printf '%s' "$xml" | tr '>' '\n' | grep -E "(text|content-desc)=\"($re)\"" | sed -n "${nth}p" \
        | grep -oE 'bounds="\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]"' | grep -oE '[0-9]+' | tr '\n' ' ')
    if [ -n "$b" ]; then
      set -- $b
      # a row in the bottom 12% may sit under the nav bar: scroll once more first —
      # unless the last scroll moved nothing (end of list), then tap where it is
      if [ "$4" -lt $(( SCREEN_H * 88 / 100 )) ] || [ "$xml" = "$prev" ]; then
        "$ADB" -s "$s" shell input tap $(( ($1+$3)/2 )) $(( ($2+$4)/2 )); sleep 2; return 0
      fi
    fi
    prev="$xml"
    # slow, short drag (no fling) so the list is still when we dump it again
    "$ADB" -s "$s" shell input swipe 500 $(( SCREEN_H * 60 / 100 )) 500 $(( SCREEN_H * 35 / 100 )) 900; sleep 1.5
  done
  return 1
}
ui_screen_has() { "$ADB" -s "$1" shell uiautomator dump /sdcard/proxy-ui.xml >/dev/null 2>&1; "$ADB" -s "$1" shell cat /sdcard/proxy-ui.xml | grep -qE "text=\"($2)\""; }
open_credentials() {   # Settings → Security → More security → Encryption & credentials
  # NEW_TASK|CLEAR_TASK: a stale screen left on top of the Settings task would hijack the flow
  "$ADB" -s "$1" shell am start -f 0x10008000 -a android.settings.SECURITY_SETTINGS >/dev/null 2>&1
  local t; for t in $(seq 1 20); do   # the Security page takes ~4s; never swipe the launcher
    "$ADB" -s "$1" shell dumpsys window 2>/dev/null | grep -q "mCurrentFocus=.*com.android.settings" && break
    sleep 0.5
  done
  sleep 1
  ui_tap "$1" "More security.*" && ui_tap "$1" "Encryption.*credentials"
}
ui_picker_action() {
  local s="$1" action="$2" xml point i
  for i in 1 2 3 4 5; do
    "$ADB" -s "$s" shell uiautomator dump /sdcard/proxy-ui.xml >/dev/null 2>&1
    xml=$("$ADB" -s "$s" shell cat /sdcard/proxy-ui.xml 2>/dev/null)
    point=$(printf '%s' "$xml" | /usr/bin/python3 -I "$SCRIPT_DIR/addons/android_picker.py" "$action" 2>/dev/null)
    if [ "$point" = OPEN ]; then return 0; fi
    if [[ "$point" =~ ^[0-9]+\ [0-9]+$ ]]; then
      "$ADB" -s "$s" shell input tap $point >/dev/null && return 0
    fi
    sleep 1
  done
  return 1
}
ui_install_ca_step() {
  local s="$1" step="$2"
  case "$step" in
    0) ui_has_current_ca "$s" ;;
    1) open_credentials "$s" ;;
    2) ui_tap "$s" "Install a certificate" && ui_tap "$s" "CA certificate" ;;
    3) ui_tap "$s" "INSTALL ANYWAY|Install anyway" ;;
    4) ui_picker_action "$s" drawer && ui_picker_action "$s" downloads && ui_picker_action "$s" file ;;
    5) ui_has_current_ca "$s" ;;
  esac
}
run_android_magisk() {
  ADB="$ADB" "$SCRIPT_DIR/addons/android_magisk.sh" "$@"
  local rc=$?
  [ "$rc" = 3 ] && exit 3  # a declined consent prompt is final; do not open Settings
  return "$rc"
}
android_settings_route() {
  local s="$1" magisk_dir="${2:-}" limit="${RIVIS_ANDROID_SETUP_TIMEOUT:-45}" before after rc prior now step label
  [[ "$limit" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk "BEGIN {exit !($limit > 0)}" \
    || die "RIVIS_ANDROID_SETUP_TIMEOUT must be a positive number of seconds"
  prior=$("$ADB" -s "$s" shell settings get global http_proxy | tr -d '\r') || die "$s: could not read the proxy before Settings setup"
  before=$(date +%s)
  rc=0
  for step in 1 2 3 4 5; do
    case "$step" in
      1) label='opening Settings > Security' ;; 2) label='choosing Install a certificate' ;;
      3) label='accepting the CA warning' ;; 4) label='opening Downloads and selecting proxy-ca.crt' ;;
      5) label='verifying the CA fingerprint' ;;
    esac
    info "$s: step $step/5: ${label}…"
    /usr/bin/python3 -I "$SCRIPT_DIR/addons/android_settings_timeout.py" "$limit" "$SCRIPT_DIR/rivis" "$s" "$step"
    rc=$?
    [ "$rc" = 0 ] || { info "$s: step $step/5 failed: $label (exit $rc)"; break; }
  done
  after=$(date +%s)
  info "$s: Settings route finished in $((after-before)) s"
  if [ "$rc" = 124 ]; then
    now=$("$ADB" -s "$s" shell settings get global http_proxy | tr -d '\r') || now="unreadable"
    if [ "$now" != "$prior" ]; then
      "$ADB" -s "$s" shell settings put global http_proxy "$prior" >/dev/null 2>&1 || true
      now=$("$ADB" -s "$s" shell settings get global http_proxy | tr -d '\r') || now="unreadable"
    fi
    info "$s: ERROR — Settings setup timed out at step $step/5 ($label) after ${limit} s. Proxy now: $now (before: $prior)."
    info "$s: proxy-ca.crt remains in Downloads; the CA may have been selected but trust was not verified. Check Settings > Security > Trusted credentials > User."
    if [ -n "$magisk_dir" ]; then
      info "  Next: Magisk was found at $magisk_dir but one-click setup failed above. Fix that failure (if the console token is unreadable, use ~/.emulator_console_auth_token from the emulator's user; if the emulator binary is missing, set ANDROID_SDK_ROOT), then retry; or finish the CA install by hand in Settings."
    else
      info "  Next: install $PRODUCT_NAME from the release zip for Magisk one-click setup, or finish the CA install by hand in Settings."
    fi
    exit 124
  fi
  return "$rc"
}
ca_fingerprint() { openssl x509 -in "$CA_PEM" -noout -fingerprint -sha256 | cut -d= -f2; }   # AA:BB:… as Settings shows it
android_record() {   # android_record SERIAL — note "<avd>\t<CA sha256>" after a VERIFIED install (read by the Devices tab)
  local avd f="$STATE_ROOT/android-ca" fp; fp=$(ca_fingerprint | tr -d ':') || return 0
  local i q
  # R5B-01: `emu avd name` can answer empty right after a boot/restart; retry, then the emulator's own property
  for i in 1 2 3; do
    avd=$("$ADB" -s "$1" emu avd name 2>/dev/null | tr -d '\r' | awk 'NF && $0 != "OK" {print; exit}')
    [[ "$avd" =~ ^[A-Za-z0-9._-]+$ ]] && break; avd=""; sleep 1
  done
  for q in ro.boot.qemu.avd_name ro.kernel.qemu.avd_name; do
    [ -n "$avd" ] && break
    avd=$("$ADB" -s "$1" shell getprop "$q" 2>/dev/null | tr -d '\r')
    [[ "$avd" =~ ^[A-Za-z0-9._-]+$ ]] || avd=""
  done
  [ -n "$avd" ] || { echo "!! $1: could not read the emulator's AVD name, so Tools → Devices may still show it as not set up (the CA IS installed)" >&2; return 0; }
  { grep -v "^$avd	" "$f" 2>/dev/null; printf '%s\t%s\n' "$avd" "$fp"; } > "$f.tmp" && mv "$f.tmp" "$f"
}
ui_list_mentions() {   # ui_list_mentions SERIAL TEXT — on this screen, or one scroll further down?
  # Settings opened cold (right after a boot) renders its list late: only answer "absent" once the screen is drawn
  # (the System/User tabs show) and two reads agree; then look one scroll further. Found = answer at once.
  local s="$1" t="$2" i x prev="" swiped=0
  for i in 1 2 3 4 5 6 7 8; do
    "$ADB" -s "$s" shell uiautomator dump /sdcard/proxy-ui.xml >/dev/null 2>&1
    x=$("$ADB" -s "$s" shell cat /sdcard/proxy-ui.xml 2>/dev/null)
    printf '%s' "$x" | grep -qF "\"$t" && return 0
    if printf '%s' "$x" | grep -qE 'text="(User|USER)"' && [ "$x" = "$prev" ]; then
      [ "$swiped" = 1 ] && return 1
      local wh w h; wh=$("$ADB" -s "$s" shell wm size | tr -d '\r' | awk '/size/{print $NF}'); w=${wh%x*}; h=${wh#*x}
      [ -n "$w" ] && [ -n "$h" ] && "$ADB" -s "$s" shell input swipe $((w/2)) $((h*7/10)) $((w/2)) $((h*3/10)) 300 >/dev/null 2>&1
      swiped=1; prev=""; sleep 1; continue
    fi
    prev="$x"; sleep 1
  done
  return 1
}
ui_has_current_ca() {   # does the user store hold THIS CA? (an older "mitmproxy" entry does not count)
  local s="$1" fp n; fp=$(ca_fingerprint) || return 1
  # straight to Trusted credentials → User (under a second); the menu walk is the fallback
  if ! "$ADB" -s "$s" shell am start -W -f 0x10008000 -a com.android.settings.TRUSTED_CREDENTIALS_USER 2>/dev/null | grep -q "Status: ok"; then
    open_credentials "$s" && ui_tap "$s" "Trusted credentials" && ui_tap "$s" "USER|User" || return 1
  fi
  sleep 1
  # quick "not there at all": the user list is a few rows — one screen and one scroll tell. ui_tap would scroll up to 12
  # times (~3 s each) before giving up, which made a fresh Play-emulator setup spend ~50 s here (2026-10-16).
  ui_list_mentions "$s" "mitmproxy" || return 1
  # only the entries that list shows: asking ui_tap for one more scrolled 12 times (~60 s), past the 45 s limit (A07)
  local total; total=$("$ADB" -s "$s" shell cat /sdcard/proxy-ui.xml 2>/dev/null | tr '>' '\n' | grep -cE '(text|content-desc)="mitmproxy"')
  [ "$total" -ge 1 ] 2>/dev/null || total=1
  [ "$total" -le 5 ] || total=5
  for n in $(seq 1 "$total"); do
    ui_tap "$s" "mitmproxy" "$n" || return 1          # no Nth entry: not found
    if ui_screen_has "$s" "$fp"; then ui_tap "$s" "OK"; return 0; fi
    ui_tap "$s" "OK" || "$ADB" -s "$s" shell input keyevent KEYCODE_BACK
  done
  return 1
}
ui_user_store_clean() {   # true when Trusted credentials → User lists no "mitmproxy" entry at all
  local s="$1"
  if ! "$ADB" -s "$s" shell am start -W -f 0x10008000 -a com.android.settings.TRUSTED_CREDENTIALS_USER 2>/dev/null | grep -q "Status: ok"; then
    open_credentials "$s" && ui_tap "$s" "Trusted credentials" && ui_tap "$s" "USER|User" || return 1
  fi
  sleep 1
  # B-04: an unreadable/blank Settings screen is not proof that the certificate is gone.
  ui_screen_has "$s" "USER|User" && ! ui_list_mentions "$s" "mitmproxy"
}
ui_remove_ca() {   # prints "REMOVED KEPT": user-store "mitmproxy" entries removed / left alone
  # Only an entry whose SHA-256 is one this workstation recorded (ca-history) is uninstalled. Every mitmproxy CA is
  # called "mitmproxy", so another workstation's or another tool's CA on the same emulator is left in place (review R3).
  local s="$1" n=0 i=1 k total fps
  fps=$(ca_history_field 1 | sed 's/../&:/g; s/:$//' | paste -sd'|' -)
  [ -n "$fps" ] || return 1
  # straight to Trusted credentials → User, like ui_has_current_ca; the menu walk is the fallback
  if ! "$ADB" -s "$s" shell am start -W -f 0x10008000 -a com.android.settings.TRUSTED_CREDENTIALS_USER 2>/dev/null | grep -q "Status: ok"; then
    open_credentials "$s" && ui_tap "$s" "Trusted credentials" && ui_tap "$s" "USER|User" || return 1
  fi
  sleep 1
  ui_list_mentions "$s" "mitmproxy" || { echo "0 0"; return 0; }     # nothing there (and no 12-scroll search)
  total=$("$ADB" -s "$s" shell cat /sdcard/proxy-ui.xml 2>/dev/null | tr '>' '\n' | grep -cE '(text|content-desc)="mitmproxy"')
  [ "$total" -le 8 ] 2>/dev/null || total=8
  for k in $(seq 1 "$total"); do
    ui_tap "$s" "mitmproxy" "$i" || return 1
    if ui_screen_has "$s" "$fps"; then
      ui_tap "$s" "Uninstall|REMOVE|Remove" && ui_tap "$s" "OK" || return 1
      n=$((n+1))                                   # the list shrank: the next entry is now number $i
    else
      ui_tap "$s" "OK" || "$ADB" -s "$s" shell input keyevent KEYCODE_BACK
      i=$((i+1))
    fi
  done
  echo "$n $((i-1))"
}

cmd_android() {
  local action="${1:-}"; shift || true
  local auto_ui=1 all=0 consent="" strict="" proxy_only=0
  while [ $# -gt 0 ]; do case "$1" in
    -s) [ $# -ge 2 ] || die "android -s needs a serial"; SERIAL="$2"; shift ;; --all) all=1 ;; --manual) auto_ui=0 ;; --yes) consent=--yes ;;
    --proxy-only) proxy_only=1 ;;                   # CA installed by hand where Rivis cannot read Settings: proxy anyway
    --strict) strict=--strict ;;                    # Play images: restart back to normal at once (two restarts)
    --auto-ui) ;;                                   # the default now; still accepted
    *) die "android: unknown option $1" ;; esac; shift; done
  case "$action" in on|off) ;; *) die "usage: $CLI android on|off [-s SERIAL | --all] [--manual] [--strict]" ;; esac
  [ -x "$ADB" ] || die "adb not found"
  if [ "$all" = 1 ]; then
    [ -z "${SERIAL:-}" ] || die "android: pass -s or --all, not both"
    local e list failed=""; list=$("$ADB" devices | awk '/^emulator-[0-9]+\tdevice$/{print $1}')
    [ -n "$list" ] || die "no running emulator (adb devices)"
    for e in $list; do
      ( SERIAL="$e"; cmd_android "$action" $([ "$auto_ui" = 0 ] && echo --manual) $([ "$proxy_only" = 1 ] && echo --proxy-only) $consent $strict ) \
        || failed="$failed $e"
    done
    # review R7: one emulator not done means the command is not done (the Devices tab and scripts read the exit code)
    [ -z "$failed" ] || die "android $action: not done on$failed (see above)"
    return
  fi
  local s; s=$(pick_serial) || exit 1
  [ "$action" = on ] && ensure_ca
  local h=""; [ -f "$CA_PEM" ] && h=$(ca_hash)
  # The user store is sufficient for debug builds that trust user CAs; no system remount is used.
  local dst="/data/misc/user/0/cacerts-added/$h.0"
  local rooted_by_us=0
  if ! have_root "$s" && "$ADB" -s "$s" root >/dev/null 2>&1; then rooted_by_us=1; fi
  sleep 2
  "$ADB" -s "$s" wait-for-device || die "$s: wait-for-device failed"
  case "$action" in
    on)
      local ca_ok=0                    # set only once the CA is verified on the emulator (review R7)
      if have_root "$s"; then
        info "$s: choosing adb-root path (root shell available)"
        "$ADB" -s "$s" push "$CA_PEM" "/data/local/tmp/$h.0" >/dev/null 2>&1 || die "push failed"
        "$ADB" -s "$s" shell "mkdir -p /data/misc/user/0/cacerts-added && cp /data/local/tmp/$h.0 $dst \
          && chmod 644 $dst && chown system:system $dst && rm /data/local/tmp/$h.0" || die "install failed"
        ca_history_add
        info "$s: CA installed in user store ($h.0)"; android_record "$s"; ca_ok=1
      else
        # Google Play images refuse `adb root`. The CA has to go in through Settings once.
        info "$s: root shell unavailable; checking the current CA and Magisk path"
        ca_history_add
        "$ADB" -s "$s" push "$CONFDIR/mitmproxy-ca-cert.cer" /sdcard/Download/proxy-ca.crt >/dev/null 2>&1 \
          || die "could not push the CA to the emulator — proxy NOT enabled"
        # one-click Play-image path needs the pinned Magisk: an installed copy has it next to the tool; a source checkout
        # keeps it in the pilot mirror. Never fall back to the slow Settings route without saying why.
        local magisk_ver magisk_dir="" d; magisk_ver=$(sed -n 's/^MAGISK_VERSION=//p' "$SCRIPT_DIR/addons/android/magisk.pins")
        if [ -n "${RIVIS_MAGISK_DIR:-}" ]; then [ -d "$RIVIS_MAGISK_DIR" ] && magisk_dir="$RIVIS_MAGISK_DIR"   # explicit: only that
        else
          for d in "$SCRIPT_DIR/../magisk-$magisk_ver" "$SCRIPT_DIR/../pilot-mirror/magisk/$magisk_ver"; do
            [ -d "$d" ] && { magisk_dir="$d"; break; }
          done
        fi
        [ "$auto_ui" = 1 ] && [ -z "$magisk_dir" ] && info "$s: one-click setup unavailable — Magisk $magisk_ver not found next to $PRODUCT_NAME (install from the release zip, or set ${ENV_PREFIX}_MAGISK_DIR); using the slower Settings route"
        local limit="${RIVIS_ANDROID_SETUP_TIMEOUT:-45}" check_rc=0
        [[ "$limit" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk "BEGIN {exit !($limit > 0)}" \
          || die "RIVIS_ANDROID_SETUP_TIMEOUT must be a positive number of seconds"
        if [ "$auto_ui" = 1 ]; then
          /usr/bin/python3 -I "$SCRIPT_DIR/addons/android_settings_timeout.py" "$limit" "$SCRIPT_DIR/rivis" "$s" 0 || check_rc=$?
          [ "$check_rc" = 124 ] && { info "$s: CA trust check timed out after ${limit} s; proxy left off"; return 124; }
        fi
        if [ "$auto_ui" = 1 ] && [ "$check_rc" = 0 ]; then
          info "$s: already trusts this CA — nothing to install"; android_record "$s"; ca_ok=1
          "$ADB" -s "$s" shell input keyevent KEYCODE_HOME
        elif [ "$auto_ui" = 1 ] && [ -n "$magisk_dir" ] \
            && info "$s: choosing one-click Magisk path ($magisk_dir)" \
            && run_android_magisk "$s" "$CA_PEM" "$h.0" "$magisk_dir" "$STATE_ROOT" $consent $strict; then
          android_record "$s"; ca_ok=1   # one-click Play-image path (Proxyman's Magisk approach); it verifies and reports
        elif [ "$auto_ui" = 1 ] && info "$s: one-click Magisk setup unavailable or failed (see reason above); choosing Settings route" \
            && android_settings_route "$s" "$magisk_dir"; then
          info "$s: CA installed in user store via Settings (verified by fingerprint)"; android_record "$s"; ca_ok=1
        else
          [ "$auto_ui" = 0 ] && info "$s is a Google Play image (no adb root) — the CA goes in through Settings once."
          [ "$auto_ui" = 1 ] && info "  could not drive this Android build's Settings — do it by hand:"
          [ "$auto_ui" = 1 ] || info "  CA pushed to Downloads. On the emulator:"
          info "  Settings → Security → More security → Encryption & credentials → Install a"
          info "  certificate → CA certificate → Install anyway → Downloads → proxy-ca.crt"
          info "  (or use a 'Google APIs' AVD without Play Store: there it is a direct copy)"
        fi
        "$ADB" -s "$s" shell input keyevent KEYCODE_HOME
      fi
      if [ "$ca_ok" = 0 ] && [ "$proxy_only" = 0 ]; then
        # review R7: with the proxy on and no trusted CA every HTTPS call fails, so the proxy waits for the CA
        info "$s: NOT DONE — the CA is not verified on this emulator yet, so the proxy was left off."
        info "  After installing it as above, run: $CLI android on -s $s   (it checks the CA, then turns the proxy on)"
        info "  If $PRODUCT_NAME cannot read this emulator's Settings: $CLI android on -s $s --proxy-only"
        exit 2
      fi
      [ "$ca_ok" = 1 ] || info "$s: --proxy-only: proxy on without a verified CA (you installed it by hand)"
      "$ADB" -s "$s" shell settings put global http_proxy "10.0.2.2:$PORT" || die "$s: setting the proxy failed"
      local now; now=$("$ADB" -s "$s" shell settings get global http_proxy | tr -d '\r') \
        || die "$s: could not verify the proxy"
      [ "$now" = "10.0.2.2:$PORT" ] || die "$s: setting the proxy failed"
      info "$s: proxy → 10.0.2.2:$PORT. Run a *Debug* variant (release builds pin TLS)."
      if [ -z "$(port_owner "$PORT")" ]; then
        info "WARNING: nothing listens on :$PORT yet — run '$CLI start' or the emulator has no internet"
      fi
      ;;
    off)
      # proxy first: it is what cuts the emulator's network if left behind
      "$ADB" -s "$s" shell settings put global http_proxy :0 || die "$s: clearing the proxy failed"
      local now; now=$("$ADB" -s "$s" shell settings get global http_proxy | tr -d '\r') \
        || die "$s: could not verify the cleared proxy"
      case "$now" in ":0"|null) info "$s: proxy cleared" ;; "") die "$s: empty proxy result — could not verify it was cleared" ;; *) die "$s: proxy still set ($now)" ;; esac
      if have_root "$s"; then
        # Every mitmproxy CA has the same subject, so another workstation's CA has the SAME file name (<hash>.0):
        # a file is removed only when its SHA-256 is one this workstation recorded (review R3).
        local hashes hh f fp want removed=0 kept=""; hashes=$(ca_history_field 2); want=$(ca_history_field 1)
        [ -n "$hashes" ] || die "$s: no CA on record and $CA_PEM is gone, cannot tell which cert to remove — list /data/misc/user/0/cacerts-added by hand"
        for hh in $hashes; do
          f="/data/misc/user/0/cacerts-added/$hh.0"
          "$ADB" -s "$s" shell "[ -e $f ]" || continue
          fp=$("$ADB" -s "$s" shell cat "$f" 2>/dev/null | tr -d '\r' | openssl x509 -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2 | tr -d :)
          if [ -n "$fp" ] && printf '%s\n' "$want" | grep -qixF "$fp"; then
            "$ADB" -s "$s" shell "rm -f $f"
            "$ADB" -s "$s" shell "[ ! -e $f ]" || die "$s: CA still present at $f"
            removed=$((removed+1))
          else kept="$kept $f"; fi
        done
        "$ADB" -s "$s" shell rm -f /sdcard/Download/proxy-ca.crt
        info "$s: removed $removed CA file(s) of this workstation ($(echo $hashes | wc -w | tr -d ' ') recorded CA(s) checked)"
        [ -z "$kept" ] || info "$s: left in place, not this workstation's CA (another mitmproxy install?):$kept"
      else
        "$ADB" -s "$s" shell rm -f /sdcard/Download/proxy-ca.crt
        local n
        if [ "$auto_ui" = 1 ] && n=$(ui_remove_ca "$s"); then
          info "$s: removed ${n% *} CA entr$( [ "${n% *}" = 1 ] && echo y || echo ies ) of this workstation via Settings"
          [ "${n#* }" = 0 ] || info "$s: left ${n#* } other \"mitmproxy\" certificate(s) in place — not this workstation's CA"
        elif [ "$auto_ui" = 1 ] && ui_user_store_clean "$s"; then
          # a Settings step after the removal failed (e.g. the confirm dialog), but the list shows no mitmproxy entry
          # any more: say what is true instead of sending the tester to remove it by hand (overnight QA r1 B-04)
          info "$s: this workstation's CA is no longer in Settings → Trusted credentials → User"
        else info "$s: remove the CA by hand: Encryption & credentials → Trusted credentials → User → mitmproxy → Uninstall"; fi
        "$ADB" -s "$s" shell input keyevent KEYCODE_HOME
      fi
      # still on the temporary setup boot of a Google Play emulator (`android on` without --strict)? back to normal now
      if ps -ax -o args= 2>/dev/null | grep -v "grep " | grep -F -- "-port ${s#emulator-} " | grep -qF -- "-ramdisk $STATE_ROOT/android-ramdisk/"; then
        ADB="$ADB" "$SCRIPT_DIR/addons/android_magisk.sh" "$s" "$CA_PEM" "${h:-00000000}.0" "-" "$STATE_ROOT" --restore \
          || info "$s: could not restart it normally — Cold Boot it from Android Studio's Device Manager"
      fi
      [ "$rooted_by_us" = 0 ] || "$ADB" -s "$s" unroot >/dev/null 2>&1 || info "$s: adb unroot failed; run adb -s $s unroot"
      ;;
  esac
}

cmd_setup() {   # every booted simulator + every running emulator; each skips what is already done
  local did=0
  if xcrun simctl list devices booted 2>/dev/null | grep -q Booted; then cmd_ios on --all; did=1
  else info "iOS: no booted simulator (boot one, then run '$CLI setup' again)"; fi
  if [ -x "$ADB" ] && "$ADB" devices 2>/dev/null | grep -qE '^emulator-[0-9]+[[:space:]]device$'; then cmd_android_logged on --all; did=1
  elif [ -x "$ADB" ]; then info "Android: no running emulator"
  else info "Android: adb not found (install the Android SDK platform-tools)"; fi
  [ "$did" = 1 ] || die "nothing to set up: no booted simulator or running emulator"
}
cmd_android_logged() {
  local log="$STATE_ROOT/logs/android-setup.log" rc
  mkdir -p -m 700 "$STATE_ROOT/logs"
  {
    trap 'rc=$?; printf "Android setup finished: exit=%s\n" "$rc"' EXIT
    printf 'Android setup run: action=%s flags=%s\n' "${1:-}" "${*:2}"
    cmd_android "$@"
    return "$?"
  } 2>&1 | /usr/bin/python3 -I "$SCRIPT_DIR/addons/android_setup_log.py" "$log"
  return "${PIPESTATUS[0]}"
}

# ───────────────────────── ios ─────────────────────────
# iOS ≤17: TrustStore.sqlite, iOS 18+/26: TrustStore.sqlite3 — same tsettings table
sim_truststore() { find "$HOME/Library/Developer/CoreSimulator/Devices/$1/data/private/var/protected/trustd" -name "TrustStore.sqlite*" -not -name "*-*" 2>/dev/null | head -1; }

cmd_ios() {
  local action="${1:-}"; shift || true; local udid="" all=0
  while [ $# -gt 0 ]; do case "$1" in --udid) [ $# -ge 2 ] || die "ios --udid needs a value"; udid="$2"; shift ;; --all) all=1 ;; *) die "ios: unknown option $1" ;; esac; shift; done
  case "$action" in on|off) ;; *) die "usage: $CLI ios on|off [--udid UDID | --all]" ;; esac
  [ -n "$udid" ] && [ "$all" = 1 ] && die "ios: pass --udid or --all, not both"
  # F-17: the UDID becomes part of a path whose trust store we edit
  [ -z "$udid" ] || [[ "$udid" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
    || die "--udid must be a simulator UDID (xcrun simctl list devices)"
  if [ -z "$udid" ]; then
    local booted; booted=$(xcrun simctl list devices booted | grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}')
    [ -z "$booted" ] && die "no booted simulator"
    if [ "$all" = 1 ]; then
      local u failed=""; for u in $booted; do
        if (cmd_ios "$action" --udid "$u"); then info "$u: ios $action complete"
        else failed="$failed $u"; echo "$CLI: $u: ios $action failed" >&2; fi
      done
      [ -z "$failed" ] || die "ios $action: not done on$failed (see above)"
      return
    fi
    [ "$(echo "$booted" | wc -l | tr -d ' ')" -gt 1 ] && die "several simulators booted — run '$CLI ios $action --all' for every one, or pass --udid: $(echo $booted)"
    udid="$booted"
  fi
  case "$action" in
    on)
      ensure_ca
      xcrun simctl keychain "$udid" add-root-cert "$CA_PEM" || die "add-root-cert failed"
      ca_history_add
      info "$udid: mitmproxy CA trusted. Use a build configured to trust the workstation CA."
      ;;
    off)
      # `simctl keychain reset` would also wipe the app's keychain (device binding,
      # passcode) and force a re-onboard. Delete only our row from the trust store.
      local db; db=$(sim_truststore "$udid")
      if [ -z "$db" ]; then info "$udid: no trust store — nothing to remove"; return; fi
      local shas; shas=$(ca_history_field 1 | tr '[:lower:]' '[:upper:]')
      [ -n "$shas" ] || die "no CA on record and $CA_PEM is gone, cannot tell which cert to remove"
      local in_list; in_list="'$(echo $shas | sed "s/ /','/g")'"     # hex digits only (filtered above)
      local n; n=$(sqlite3 "$db" "begin immediate; delete from tsettings where hex(sha256) in ($in_list); select changes(); commit;") \
        || die "$udid: could not edit the trust store (sim busy? shut it down and retry)"
      [ "$(sqlite3 "$db" "select count(*) from tsettings where hex(sha256) in ($in_list);")" = 0 ] || die "$udid: CA still trusted"
      info "$udid: removed $n trust entr$( [ "$n" = 1 ] && echo y || echo ies ) for the mitmproxy CA (restart the app; reboot the sim if it still trusts it)"
      ;;
  esac
}

# ───────────────────────── net-reset ─────────────────────────
# FRTMProxy / Proxyman restore whatever proxy state they found at launch. If that was a
# leftover 127.0.0.1 from a crashed session, every Mac app loses the network once the
# proxy app quits. A dead port is cleared only after its previously observed listener process has exited.
cmd_net_reset() {   # [--dry-run | --auto]  --auto reports changes and unproven loopback settings
  local dry=0 auto=0; [ "${1:-}" = "--dry-run" ] && dry=1; [ "${1:-}" = "--auto" ] && auto=1
  local changed=0 enabled=0 stale_seen="" failed=0 known="$STATE_ROOT/proxy-owner-history" owner proof owner_line owner_pid observed active_seen="" recorded_pid
  while IFS= read -r svc; do
    case "$svc" in ""|"An asterisk"*|\**) continue ;; esac
    local kind getter setter details on host port label
    for kind in web secure socks; do
      case "$kind" in
        web) getter=-getwebproxy; setter=-setwebproxystate; label=http ;;
        secure) getter=-getsecurewebproxy; setter=-setsecurewebproxystate; label=https ;;
        socks) getter=-getsocksfirewallproxy; setter=-setsocksfirewallproxystate; label=socks ;;
      esac
      details=$(networksetup "$getter" "$svc" 2>/dev/null) || continue
      on=$(printf '%s\n' "$details" | awk '/^Enabled:/{print $2;exit}')
      [ "$on" = Yes ] || continue
      enabled=1
      host=$(printf '%s\n' "$details" | awk '/^Server:/{sub(/^Server:[[:space:]]*/,"");print;exit}')
      port=$(printf '%s\n' "$details" | awk '/^Port:/{print $2;exit}')
      owner=""; proof=0
      if [[ "$port" =~ ^[0-9]+$ ]] && { [ "$host" = 127.0.0.1 ] || [ "$host" = localhost ]; }; then
        owner_line=$(port_owner "$port")
        if port_accepts "$port"; then
          active_seen="$active_seen $host:$port"
          owner=$(printf '%s\n' "$owner_line" | awk '{print $1}')
          owner_pid=$(printf '%s\n' "$owner_line" | awk '{print $3}')
          observed=0
          [ "$owner" = Proxyman ] && observed=1
          [ "$owner" = mitmweb ] && [ -n "$owner_pid" ] && our_mitmweb "$owner_pid" && observed=1
          if [ "$observed" = 1 ] && [ "$dry" = 0 ]; then
            (umask 077; mkdir -p "$STATE_ROOT") || die "cannot record observed proxy ownership"
            { [ -f "$known" ] && awk -v p="$host:$port" '$1 != p' "$known" || true; printf '%s %s\n' "$host:$port" "$owner_pid"; } > "$known.tmp"
            chmod 600 "$known.tmp"; mv -f "$known.tmp" "$known"
          fi
        else
          recorded_pid=$(awk -v p="$host:$port" '$1 == p {print $2; exit}' "$known" 2>/dev/null)
          if [ -z "$owner_line" ] && ! [[ " $active_seen " == *" $host:$port "* ]] \
              && [[ "$recorded_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$recorded_pid" 2>/dev/null \
              && [ -z "$(ps -p "$recorded_pid" -o pid= 2>/dev/null)" ]; then proof=1; fi
        fi
      fi
      if [ "$proof" = 1 ] && ! port_accepts "$port"; then
        changed=1
        [ "$auto" = 1 ] || echo "  $svc: $label=$host:$port — $([ "$dry" = 1 ] && echo 'would clear' || echo 'clearing')"
        if [ "$dry" = 0 ] && ! networksetup "$setter" "$svc" off; then
          # a standard account may not change network settings: say how, and let `start` go on (Android, web apps
          # and Compose work; only the iOS Simulator follows the Mac's proxy until it is cleared)
          echo "$CLI: could not clear the leftover $label proxy $host:$port on $svc (this account may not change network settings)." >&2
          echo "  Clear it in System Settings → Network → $svc → Details → Proxies (turn off the proxies set to $host:$port), or ask IT." >&2
          failed=1
          continue
        fi
        stale_seen="$host:$port"
      else
        if [ "$auto" = 1 ] && [ -z "$owner" ] && { [ "$host" = 127.0.0.1 ] || [ "$host" = localhost ]; }; then
          if [[ " $active_seen " == *" $host:$port "* ]]; then
            echo "$CLI: $svc $label proxy $host:$port is in use (TCP connection succeeded) — left alone" >&2
          else
            echo "$CLI: $svc $label proxy $host:$port left alone; cannot prove it is a dead $PRODUCT_NAME/Proxyman leftover" >&2
          fi
        elif [ "$auto" = 0 ]; then
          echo "  $svc: $label=$host:$port — left alone (active or origin unproven)"
        fi
      fi
    done
  done < <(networksetup -listallnetworkservices)
  if [ "$changed" = 1 ] && [ "$failed" = 0 ] && [ -n "$stale_seen" ]; then
    awk -v p="$stale_seen" '$1 != p' "$known" > "$known.tmp" 2>/dev/null || true
    mv -f "$known.tmp" "$known"
  fi
  if [ "$auto" = 1 ]; then
    [ -n "$stale_seen" ] && info "fixed: a previously observed $PRODUCT_NAME/Proxyman proxy at $stale_seen no longer accepts connections — cleared"
    return 0
  fi
  if [ "$enabled" = 0 ]; then info "no system proxy set on any service — network is clean"
  elif [ "$changed" = 0 ]; then info "no stale local proxy found — enabled proxies were left alone"
  elif [ "$dry" = 1 ]; then info "dry run: only the stale local proxies above would be cleared"
  elif [ "$failed" = 1 ]; then return 1
  else info "stale local proxies cleared; all other proxies left alone"; fi
}

# ───────────────────────── status ─────────────────────────
saved_upstream() {
  [ -f "$UPSTREAM_FILE" ] && cat "$UPSTREAM_FILE" || echo direct
}
cmd_status() {
  ensure_rules
  local o; o=$(port_owner "$PORT"); echo "proxy :$PORT     ${o:-not listening}"
  local w; w=$(port_owner "$WEB_PORT"); echo "web UI :$WEB_PORT   ${w:-not listening}"
  warn_running_version # R4A-01
  local sp; sp=$(scutil --proxy | awk '/HTTPSEnable/{e=$3} /HTTPSProxy/{h=$3} /HTTPSPort/{p=$3} END{if(e==1)print h":"p; else print "off"}')
  # R5A-03: these ports may host a different project from the CLI's current selection.
  local running_project="" pid args state_json=""
  if [ -n "$w" ] && [ -n "$(our_listeners)" ]; then
    state_json=$(ui_curl /proxy/api/state --max-time 3 2>/dev/null) || state_json=""
    running_project=$(printf '%s' "$state_json" | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("active_project") or "")' 2>/dev/null) || running_project=""
    if [ -z "$running_project" ]; then
      for pid in $(our_listeners); do
        args=$(ps -ww -o args= -p "$pid" 2>/dev/null) || continue
        running_project=$(printf '%s\n' "$args" | sed -n 's/.*proxy_project=\([a-z0-9._-]*\).*/\1/p')
        [ -z "$running_project" ] || break
      done
    fi
  fi
  if [ -n "$running_project" ] && [ "$running_project" != "$PROJECT" ]; then
    echo "project: $running_project (running on :$PORT)"
    echo "selected project: $PROJECT ($PROJECT_LABEL)"
  else
    echo "project: ${running_project:-$PROJECT} ($PROJECT_LABEL)"
  fi
  warn_running_project
  echo "upstream proxy: $(saved_upstream)"
  [ -z "$state_json" ] || printf '%s' "$state_json" | /usr/bin/python3 -I -c 'import json,sys; s=[x for x in (json.load(sys.stdin).get("skipped_rules") or []) if isinstance(x, dict)]; s and print("WARNING: %d rule(s) skipped, not applied: %s. Details: %s rules list" % (len(s), "; ".join("%s (%s)" % (x.get("name", "?"), x.get("error", "invalid")) for x in s), sys.argv[1]))' "$CLI" 2>/dev/null # review 0.9.7 #11
  /usr/bin/python3 -I -c 'import json,sys; sys.path.insert(0,sys.argv[1]); from proxy_common import tls_config
t=tls_config(json.load(open(sys.argv[2]))); n=len(t[t["mode"]]) if t["mode"]!="all" else 0
print("TLS decryption: %s%s" % (t["mode"], (" (%d host pattern%s)" % (n, "" if n==1 else "s")) if t["mode"]!="all" else " (every host)"))' "$SCRIPT_DIR/addons" "$RULES" 2>/dev/null || echo "TLS decryption: unreadable rules file"
  /usr/bin/python3 -I -c 'import json,sys; c=json.load(open(sys.argv[1])); isinstance(c, dict) and c.get("no_cache") and print("No caching: on")' "$RULES" 2>/dev/null || true
  [ "$PROJECT_ANDROID" = "[]" ] || echo "project Android packages: $PROJECT_ANDROID"
  [ "$PROJECT_IOS" = "[]" ] || echo "project iOS bundle IDs: $PROJECT_IOS"
  echo "macOS system https proxy: $sp"
  if [[ "$sp" == 127.0.0.1:* || "$sp" == localhost:* ]] && [[ "${sp##*:}" =~ ^[0-9]+$ ]] \
      && ! port_accepts "${sp##*:}"; then
    echo "  ! no TCP connection to that proxy; inspect the setting. $CLI net-reset clears only a previously observed dead $PRODUCT_NAME/Proxyman listener."
  fi
  if [ -x "$ADB" ]; then
    for s in $("$ADB" devices | awk '/^emulator-[0-9]+\tdevice$/{print $1}'); do
      echo "android $s: http_proxy=$("$ADB" -s "$s" shell settings get global http_proxy | tr -d '\r')"
    done
  fi
  xcrun simctl list devices booted 2>/dev/null | grep -E "Booted" | sed 's/^ */ios booted: /'
  # which devices and apps the running instance has calls from (proxy_source.py), as in the panel's Source menu
  [ -n "$state_json" ] && printf '%s' "$state_json" | /usr/bin/python3 -I -c 'import json,sys
s=json.load(sys.stdin); rows=(s.get("sources") or {}).get("list") or []
kind={"ios":"iOS Simulator","android":"Android emulator","browser":"web browser","mac":"this Mac","unknown":"unknown"}
print("sources: %s" % ("none yet" if not rows else "%d (calls in the list)" % len(rows)))
for r in rows: print("  %-52s %6d  %s" % ((r["app"] + " on " if r["app"] else "") + (r["device"] or kind.get(r["kind"], r["kind"])), r["count"], kind.get(r["kind"], r["kind"])))
sel=s.get("source")
if sel:
  row=next((r for r in rows if r["key"]==sel), None); dev=sel.split("|")
  if sel.startswith("unknown|"): text="calls with no known source (Unknown)"
  elif row: text=(row["app"]+" on " if row["app"] else "")+(row["device"] or kind.get(row["kind"],row["kind"]))
  else: text="every app on "+(dev[1] or kind.get(dev[0],dev[0]))
  print("  list shows only: %s" % text)' 2>/dev/null
  systemextensionsctl list 2>/dev/null | grep -q "macos-redirector.*activated enabled" \
    && echo "local-capture extension: enabled" \
    || echo "local-capture extension: NOT enabled — System Settings → General → Login Items & Extensions → Network Extensions → Mitmproxy Redirector"
  if /usr/bin/python3 -I "$SCRIPT_DIR/addons/scripts_cli.py" "$RULES" --script-dir "$PROJECT_STATE/scripts" list 2>/dev/null | grep -qE '^  (ON |off) .* js '; then
    local node_path
    node_path=$(/usr/bin/python3 -I -c 'import runpy,sys; d=runpy.run_path(sys.argv[1]); print(d["find_node"]() or "")' "$SCRIPT_DIR/addons/proxy_scripts.py")
    [ -n "$node_path" ] || echo "scripts: Node.js not installed (brew install node or https://nodejs.org) — JS scripts disabled (Python scripts still work)"
  fi
  # exit status answers "is it running?" for scripts and CI (QA-11): 0 running, 3 not running (the LSB status code)
  [ -n "$(our_listeners)" ] && [ -n "$o" ] && [ -n "$w" ] || return 3
}

# doctor — read-only health check (never writes unless --fix-safe + confirm).
# Deliberately does NOT call ensure_rules/secure_dirs/migrate_legacy: it must not mutate state.
cmd_doctor() {
  [ -x "$SCRIPT_DIR/addons/doctor.py" ] || true
  /usr/bin/python3 -I "$SCRIPT_DIR/addons/doctor.py" \
    --project "$PROJECT" --rules "$RULES" --confdir "$CONFDIR" \
    --port "$PORT" --web-port "$WEB_PORT" --script-dir "$PROJECT_STATE/scripts" \
    --adb "$ADB" --upstream "$(saved_upstream)" "$@"
}

cmd_bug_report() {
  local out=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --output) [ $# -ge 2 ] || die "bug-report: --output needs a path"; out=(--output "$2"); shift ;;
      *) die "bug-report: unknown option $1" ;;
    esac
    shift
  done
  /usr/bin/python3 -I "$SCRIPT_DIR/addons/bug_report.py" \
    --state-root "$STATE_ROOT" --project "$PROJECT" --rules "$RULES" --confdir "$CONFDIR" \
    --port "$PORT" --web-port "$WEB_PORT" --script-dir "$PROJECT_STATE/scripts" --adb "$ADB" ${out[@]+"${out[@]}"}
}

cmd_cert() {
  ensure_ca
  echo "CA:        $CA_PEM"
  echo "sha256:    $(ca_sha256)"
  echo "android:   $(ca_hash).0"
  openssl x509 -in "$CA_PEM" -noout -enddate
}

# `<cmd> … --help` prints help and does NOTHING else: stop/setup/cert/status used to ignore it and run (QA TXT-03/04)
if [ $# -ge 2 ]; then for _a in "${@:2}"; do case "$_a" in -h|--help) usage_for "$1"; exit 0 ;; esac; done; fi
case "${1:-}" in -h|--help|help|""|cert|doctor|bug-report) ;; *) migrate_legacy || exit 1 ;; esac

case "${1:-}" in
  projects)  shift; cmd_projects "$@" ;;
  start)     shift; cmd_start "$@" ;;
  android)   shift; cmd_android_logged "$@" ;;
  __android_settings) shift; ui_install_ca_step "$1" "$2" ;;
  setup)     shift; cmd_setup "$@" ;;
  ios)       shift; cmd_ios "$@" ;;
  net-reset) shift; cmd_net_reset "$@" ;;
  status)    cmd_status ;;
  ui)        cmd_ui ;;
  browser)   shift; cmd_browser "$@" ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  health)    cmd_health ;;
  rollback)  shift; cmd_rollback "$@" ;;
  rules)     shift; cmd_rules "$@" ;;
  scripts)   shift; cmd_scripts "$@" ;;
  throttle)  shift; cmd_throttle "$@" ;;
  nocache)   shift; cmd_nocache "$@" ;;
  tls)       shift; cmd_tls "$@" ;;
  compose)   shift; cmd_compose "$@" ;;
  breakpoint) shift; cmd_breakpoint "$@" ;;
  mock)      shift; cmd_mock "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  bug-report) shift; cmd_bug_report "$@" ;;
  update)    shift; cmd_update "$@" ;;
  uninstall) die "run install.sh --uninstall from the unzipped Rivis release zip (download: https://github.com/CoorB/rivis/releases)" ;;
  cert)      cmd_cert ;;
  --version|-V|version)   # installed copies carry VERSION at their root; a repo checkout keeps it in install/
    v=$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || cat "$SCRIPT_DIR/install/VERSION" 2>/dev/null || echo dev)
    echo "$CLI $(echo "$v" | tr -d '[:space:]')" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command '$1' ($CLI --help)" ;;
esac
