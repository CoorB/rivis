#!/usr/bin/env bash
# Product-neutral mitmproxy wrapper for macOS.
#
# SECURITY CONDITIONS THIS SCRIPT ENFORCES (IT approval, 2026-10)
#   * proxy binds 127.0.0.1 only — never 0.0.0.0. Android emulators still reach it
#     (10.0.2.2 = host loopback); physical devices cannot, by design.
#   * NEVER touches the macOS system proxy. The iOS Simulator is captured with
#     mitmproxy local-capture mode scoped to simulator processes only.
#   * one CA per workstation (~/.mitmproxy), installed only on sims/emulators,
#     and `off` removes it again.
#
#   <cli> [--project ID] start [--insecure] [--project-only] [--all] [--no-ios] [--no-open] [--background]
#                                 mitmweb: proxy 127.0.0.1:8080, UI 127.0.0.1:8083 (opens logged in)
#                                 --background keep running after this Terminal window closes
#                                              (like an app; '<cli> stop' ends it, log in ~/.rivis/logs)
#                                 --insecure   disable upstream TLS verification (--dev alias)
#                                 --project-only show only the active project's hosts (--neo-only alias)
#                                 --all        also show DNS/UDP rows (hidden by default)
#                                 --no-ios     regular proxy only (Android emulator)
#                                 --ios-filter local-capture process filter (default CoreSimulator)
#                                 --allow-private-hosts REGEX  also let plain-HTTP calls reach these hosts on private
#                                              addresses (HTTPS, simulator capture and Repeat always may)
#   <cli> projects list|use ID|show ID|new ID --label L --hosts REGEX
#   <cli> ui | stop | restart | status | cert
#   <cli> browser [URL | --current] [--browser chrome|edge|chromium|brave] [--fresh] [--list]
#                                 web apps: a separate browser window with its own profile, pointed at the
#                                 proxy and trusting only this CA. Your normal browser, the system proxy
#                                 and the keychain are not touched. --current: open the page of your
#                                 browser's front tab (Chrome, Edge, Brave, Chromium, Safari). --fresh: a
#                                 temporary profile
#   <cli> rules list|on NAME|off NAME|show NAME|rm NAME|test URL [METHOD]|edit|allow-file PATH|disallow-file PATH|trusted-files
#   <cli> rules add NAME match=REGEX action=ACTION [key=value ...]
#                                 Proxyman-style rules, hot-reloaded, kept across restarts:
#                                 respond | map_local | status | json_patch | delay |
#                                 set_header | map_remote | block   (see rules.example.json)
#                                 set_header: header=NAME value=TEXT [side=request|response];
#                                 json_patch: set='path=value' (or set='{"path":value}'); map_remote: replace=REGEX with=URL
#   <cli> scripts list|new NAME --lang py|js [--match REGEX]|on NAME|off NAME|edit NAME|rm NAME
#   <cli> throttle off|3g-urban|lte-congested|high-latency-vpn|packet-loss-8|manual|lte|3g|edge|slow|<ms>ms[/<kbps>kbps]
#                 [match=REGEX] [loss=PCT] [latency_ms=N jitter_ms=N down_kbps=N up_kbps=N loss_pct=N response_delay_ms=N]
#   <cli> nocache on|off|status            No Caching: strip If-None-Match/If-Modified-Since… from requests and
#                                 force no-store on responses, so the app never gets a 304 (Map Local untouched)
#   <cli> tls list | mode all|allow|ignore | allow add|rm PATTERN | ignore add|rm PATTERN
#                                 which hosts are decrypted (Proxyman "SSL Proxying list"); wildcards like
#                                 *.example.test. Hot-reloaded for NEW connections — no restart.
#   <cli> compose list | send NAME [--var name=value] [--no-wait]
#                                 replay a request saved in the panel's Compose tab through the running proxy
#   <cli> breakpoint [URL-REGEX [--request|--response] [--method M] | off [NAME]]
#                                 pause matching calls in the UI to edit them, then Continue
#                                 (no arguments: list them; off without NAME: remove all)
#   <cli> mock NAME URL-REGEX              save the last matching response and Map-Local it
#   <cli> setup                            ios on --all + android on --all: every booted simulator and
#                                 running emulator, in one go (each one is skipped if already done)
#   <cli> android on|off [-s SERIAL | --all] [--manual] [--yes] [--strict] [--proxy-only]
#                                 CA + proxy on an emulator. Google APIs image (no Play Store): direct
#                                 copy via adb root. Google Play image: drives the Settings screens itself,
#                                 skips them when the emulator already trusts this CA (fingerprint check),
#                                 and verifies the result; prints the steps if a screen does not match.
#                                 --manual: only print the steps. --yes: consent to the one-time
#                                 Play-image setup without asking (scripts). The proxy is turned on only
#                                 once the CA is verified (exit 2 = not done yet); --proxy-only turns it
#                                 on anyway, for a CA installed by hand where Settings cannot be read
#   <cli> ios on|off [--udid UDID | --all] CA on a simulator (default: the booted one; --all: every booted one)
#   <cli> net-reset [--dry-run|--auto]     clear stale local web/https/socks proxies on every network
#                                         service — fixes "no internet after closing the proxy app"
#   <cli> doctor [--json] [--no-net] [--fix-safe [--yes]]
#                                 read-only health check: versions, CA, ports, system proxy,
#                                 sim/emulator trust, running state, host reachability, disk.
#                                 --fix-safe does only safe, reversible fixes (asks y/N)
#   <cli> bug-report [--output PATH]     create a redacted support bundle (no flows or tokens)
#   <cli> update [check|install|login|logout|status]   signed in-app updates from the team's GitHub releases
#   <cli> health                  is the running proxy answering, on the installed version? (exit 0 = yes)
#   <cli> rollback [VERSION|--list]   go back to an earlier installed version and restart with the same options
set -uo pipefail
umask 077

# Rivis's helpers run on macOS's own Python 3 (/usr/bin/python3), which comes with Apple's Command Line Tools or
# Xcode. Without them every call pops an install dialog and fails with shell errors (night review A2): say it once.
if [ "$(uname -s)" = Darwin ] && [ -z "${SKIP_CLT_CHECK:-}" ]; then
  # the developer directory /usr/bin/python3 uses: $DEVELOPER_DIR first, then xcode-select's (as xcrun resolves it)
  _clt="${DEVELOPER_DIR:-}"; [ -n "$_clt" ] || _clt=$(xcode-select -p 2>/dev/null) || _clt=""
  if [ -z "$_clt" ] || [ ! -x "$_clt/usr/bin/python3" ]; then
    echo "$(basename "$0"): needs Apple's Command Line Tools first (free, one time, a few minutes; no Xcode needed)." >&2
    echo "  Run:  xcode-select --install     then, when it has finished, run this again." >&2
    exit 1
  fi
fi

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd -P)"   # works through a ~/bin symlink
PRODUCT_JSON="$SCRIPT_DIR/product.json"

product_value() {
  /usr/bin/python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$PRODUCT_JSON" "$1"
}
PRODUCT_NAME="$(product_value name)"
CLI="$(product_value cli)"
die() { echo "$CLI: $*" >&2; exit 1; }
ENV_PREFIX="$(product_value env_prefix)"
STATE_ROOT="$(product_value state_dir)"
STATE_ROOT="${STATE_ROOT/#\~/$HOME}"

env_value() {
  local suffix="$1" fallback="$2" var value=""
  var="${ENV_PREFIX}_${suffix}"
  value="$(printenv "$var" 2>/dev/null || true)"
  [ -n "$value" ] || value="$(printenv "NEO_MITM_${suffix}" 2>/dev/null || true)"
  printf '%s' "${value:-$fallback}"
}

# --project is global and accepted before or after every command.
PROJECT_ARG=""
ARGS=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--" ]; then
    shift
    while [ $# -gt 0 ]; do ARGS+=("$1"); shift; done
  elif [ "$1" = "--project" ]; then
    [ $# -ge 2 ] || { echo "$CLI: --project needs an ID" >&2; exit 1; }
    PROJECT_ARG="$2"; shift 2
  elif [[ "$1" == --project=* ]]; then
    PROJECT_ARG="${1#--project=}"; [ -n "$PROJECT_ARG" ] || { echo "$CLI: --project needs an ID" >&2; exit 1; }
    shift
  else
    ARGS+=("$1"); shift
  fi
done
[ ${#ARGS[@]} -gt 0 ] && set -- "${ARGS[@]}" || set --

PROJECT_ENV="$(env_value PROJECT "")"
PROJECT_SOURCE="default"
if [ -n "$PROJECT_ARG" ]; then PROJECT="$PROJECT_ARG"; PROJECT_SOURCE="argument"
elif [ -n "$PROJECT_ENV" ]; then PROJECT="$PROJECT_ENV"; PROJECT_SOURCE="environment"
elif [ -f "$STATE_ROOT/current-project" ]; then PROJECT="$(sed -n '1p' "$STATE_ROOT/current-project")"; PROJECT_SOURCE="current-project"
elif [ -d "$HOME/.neo-mitm" ] && [ ! -e "$STATE_ROOT/projects/neo" ]; then PROJECT="neo"; PROJECT_SOURCE="legacy"   # first run after neo-mitm: its state becomes project neo (migrate_legacy)
else PROJECT="default"; fi

valid_id() { [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]]; }
if ! valid_id "$PROJECT"; then
  if [ "$PROJECT_SOURCE" = "current-project" ]; then
    echo "$CLI: warning: ignoring invalid current-project '$PROJECT'; using default" >&2
    PROJECT="default"
  else echo "$CLI: invalid project ID '$PROJECT'" >&2; exit 1; fi
fi

profile_dir() {
  if [ -f "$STATE_ROOT/profiles/$1/project.json" ]; then printf '%s' "$STATE_ROOT/profiles/$1"
  elif [ -f "$SCRIPT_DIR/projects/$1/project.json" ]; then printf '%s' "$SCRIPT_DIR/projects/$1"
  else return 1; fi
}
if ! PROJECT_PROFILE="$(profile_dir "$PROJECT")"; then
  if [ "$PROJECT_SOURCE" = "current-project" ]; then
    echo "$CLI: warning: current project '$PROJECT' no longer exists; using default" >&2
    PROJECT="default"
    PROJECT_PROFILE="$(profile_dir "$PROJECT")" || { echo "$CLI: default project profile is missing" >&2; exit 1; }
  else echo "$CLI: unknown project '$PROJECT' ($CLI projects list)" >&2; exit 1; fi
fi
PROJECT_JSON="$PROJECT_PROFILE/project.json"
project_value() {
  /usr/bin/python3 -I -c 'import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2],""); print(v if not isinstance(v,(dict,list)) else json.dumps(v))' "$PROJECT_JSON" "$1"
}
PROJECT_LABEL="$(project_value label)"
PROJECT_HOSTS="$(project_value hosts)"
PROJECT_ANDROID="$(project_value android_packages)"
PROJECT_IOS="$(project_value ios_bundle_ids)"
PROJECT_STATE="$STATE_ROOT/projects/$PROJECT"

PORT="$(env_value PORT 8080)"
WEB_PORT="$(env_value WEB_PORT 8083)"
# R4A-05: web port becomes part of a private filename; reject paths and malformed port values.
for p in "$PORT" "$WEB_PORT"; do [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || die "proxy and web ports must be integers from 1 to 65535"; done
# R4A-05: a second web port must not rotate the first instance's login or one-time bootstrap.
if [ "$WEB_PORT" = 8083 ]; then TOKEN_FILE="$STATE_ROOT/web-token"; BOOTSTRAP_FILE="$STATE_ROOT/web-bootstrap"; START_FILE="$STATE_ROOT/last-start"
else TOKEN_FILE="$STATE_ROOT/web-token-$WEB_PORT"; BOOTSTRAP_FILE="$STATE_ROOT/web-bootstrap-$WEB_PORT"; START_FILE="$STATE_ROOT/last-start-$WEB_PORT"; fi
UPSTREAM_FILE="$STATE_ROOT/upstream-$WEB_PORT"
MAX_FLOWS="$(env_value MAX_FLOWS 5000)"
[[ "$MAX_FLOWS" =~ ^[0-9]+$ ]] && [ "$MAX_FLOWS" -ge 1 ] && [ "$MAX_FLOWS" -le 1000000 ] || \
  { echo "$CLI: ${ENV_PREFIX}_MAX_FLOWS must be an integer from 1 to 1000000" >&2; exit 1; }
CONFDIR="$(env_value CONFDIR "$HOME/.mitmproxy")"
CA_PEM="$CONFDIR/mitmproxy-ca-cert.pem"
# adb: the same places the panel's Devices tab looks (addons/devices.py adb_path), so a custom SDK location works in both
find_adb() {
  local c
  for c in "${ANDROID_SDK_ROOT:+$ANDROID_SDK_ROOT/platform-tools/adb}" "${ANDROID_HOME:+$ANDROID_HOME/platform-tools/adb}" \
           "$HOME/Library/Android/sdk/platform-tools/adb" /usr/local/bin/adb /opt/homebrew/bin/adb; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return; }
  done
  command -v adb || printf '%s' "$HOME/Library/Android/sdk/platform-tools/adb"
}
ADB="${ADB:-$(find_adb)}"
RULES="$(env_value RULES "$PROJECT_STATE/rules.json")"
WEB_PASSWORD="$(env_value WEB_PASSWORD "")"
ADDON="$SCRIPT_DIR/addons/proxy_rules.py"
AUTH_ADDON="$SCRIPT_DIR/addons/proxy_auth.py"

usage() { awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0" | sed "s/<cli>/$CLI/g; s/<ProductName>/$PRODUCT_NAME/g"; }
usage_for() {   # usage_for CMD — only that command's lines of the usage above (all of it if CMD has none)
  local out; out=$(usage | awk -v c="$CLI" -v cmd="$1" '
    { line = $0; sub(/^ +/, "", line); sub(/^\[--project ID\] /, "", line)
      if (index(line, c " ") == 1) {            # a command line: is CMD one of its words (e.g. "ui | stop | status")?
        part = substr(line, length(c) + 2); sub(/  .*/, "", part)
        p = (part ~ ("(^|[ |])" cmd "( |$)")) } }
    p { print }')
  if [ -n "$out" ]; then echo "$out"; else usage; fi
}
info()  { echo "• $*"; }

atomic_private_text() {
  local path="$1" text="$2" dir tmp
  dir=$(dirname "$path")
  (umask 077; mkdir -p "$dir") || return 1
  tmp=$(mktemp "$dir/.write.XXXXXX") || return 1
  if ! printf '%s\n' "$text" > "$tmp"; then rm -f "$tmp"; return 1; fi
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$path" || { rm -f "$tmp"; return 1; }
}

rotate_log() {
  local file="$1" max="${2:-3}" i
  [ -s "$file" ] || return 0
  rm -f "${file}.${max}"
  i=$((max - 1))
  while [ "$i" -ge 1 ]; do
    [ -f "${file}.${i}" ] && mv -f "${file}.${i}" "${file}.$((i + 1))"
    i=$((i - 1))
  done
  mv -f "$file" "${file}.1"
}

ensure_ca() {
  if [ -f "$CA_PEM" ]; then
    # a damaged CA would be silently replaced by mitmproxy, and every device set up with the old one stops trusting
    # Rivis: stop and say so, keeping the old files until the tester decides (night QA A13)
    openssl x509 -in "$CA_PEM" -noout 2>/dev/null && return
    die "the certificate in $CONFDIR is damaged (not a readable certificate). Keep it aside and let $PRODUCT_NAME make a new one:
  mv '$CONFDIR' '$CONFDIR.damaged-$(date +%Y%m%d)'   then: $CLI start   (and Set up each simulator/emulator again)"
  fi
  info "no CA yet in $CONFDIR — generating one (first mitmproxy run does this)"
  command -v mitmdump >/dev/null || die "mitmproxy not installed (install the pinned build from the internal mirror)"
  mitmdump --listen-host 127.0.0.1 --listen-port 0 --set confdir="$CONFDIR" >/dev/null 2>&1 & local p=$!
  for _ in $(seq 1 20); do [ -f "$CA_PEM" ] && break; sleep 0.5; done
  kill "$p" 2>/dev/null; wait "$p" 2>/dev/null
  [ -f "$CA_PEM" ] || die "CA was not generated in $CONFDIR"
}

ca_hash()   { openssl x509 -inform PEM -subject_hash_old -noout -in "$CA_PEM"; }
ca_sha256() { openssl x509 -in "$CA_PEM" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d :; }

# F-07: every CA we ever put on a device is remembered (sha256 + Android subject-hash name), so `off` also removes
# the CAs of earlier regenerations — not just the one in $CONFDIR now.
CA_HISTORY="$STATE_ROOT/ca-history"
ca_history_add() {
  [ -f "$CA_PEM" ] || return 0
  local entry old=""; entry="$(ca_sha256) $(ca_hash)"
  grep -qxF "$entry" "$CA_HISTORY" 2>/dev/null && return 0
  [ ! -f "$CA_HISTORY" ] || old=$(cat "$CA_HISTORY")
  atomic_private_text "$CA_HISTORY" "${old:+$old
}$entry"
}
ca_history_field() {  # 1 = sha256, 2 = android hash; current CA first, then every recorded one
  { [ -f "$CA_PEM" ] && { [ "$1" = 1 ] && ca_sha256 || ca_hash; }
    [ -f "$CA_HISTORY" ] && awk -v f="$1" '$f ~ /^[0-9A-Fa-f]+$/ {print $f}' "$CA_HISTORY"; } | awk '!seen[$0]++'
}

safe_name() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]] && [[ "$1" != .* ]] || die "name '$1': letters, digits, . _ - only (max 64, not starting with .)"; }

port_owner() { lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR==2{print $1" pid "$2" "$9}'; }
port_accepts() { /usr/bin/python3 -I -c 'import socket,sys; s=socket.socket(); s.settimeout(.5); sys.exit(s.connect_ex(("127.0.0.1",int(sys.argv[1]))) != 0)' "$1"; }

secure_dirs() {
  (umask 077; mkdir -p "$STATE_ROOT" "$PROJECT_STATE" "$PROJECT_STATE/mocks" \
    "$PROJECT_STATE/collections" "$PROJECT_STATE/sessions" "$PROJECT_STATE/scripts" "$STATE_ROOT/profiles")
  chmod 700 "$STATE_ROOT" "$PROJECT_STATE" "$PROJECT_STATE/mocks" \
    "$PROJECT_STATE/collections" "$PROJECT_STATE/sessions" "$PROJECT_STATE/scripts" "$STATE_ROOT/profiles" 2>/dev/null || true
}

migrate_legacy() {
  local old="$HOME/.neo-mitm" parent="$STATE_ROOT/projects" target="$STATE_ROOT/projects/neo" tmp
  [ -d "$old" ] || return 0
  [ -e "$target" ] && return 0
  (umask 077; mkdir -p "$parent") || return 1
  tmp=$(mktemp -d "$parent/.neo.tmp.XXXXXX") || return 1
  if ! (umask 077
    [ ! -f "$old/rules.json" ] || cp "$old/rules.json" "$tmp/rules.json"
    for d in mocks collections sessions; do [ ! -d "$old/$d" ] || cp -R "$old/$d" "$tmp/$d"; done
  ); then
    rm -rf "$tmp"
    echo "$CLI: legacy state copy failed; migration will be retried next time" >&2
    return 1
  fi
  if [ -f "$tmp/rules.json" ] && ! /usr/bin/python3 -I - "$tmp/rules.json" "$old/mocks" "$target/mocks" <<'PY'
import json, os, sys, tempfile
path, old, new = sys.argv[1:]
try:
    with open(path) as fh:
        doc = json.load(fh)
except (OSError, ValueError):
    raise SystemExit(0)
changed = False
for rule in doc.get("rules", []):
    for key in ("file", "body_file"):
        if not isinstance(rule.get(key), str):
            continue
        expanded = os.path.expanduser(rule[key])
        if expanded == old or expanded.startswith(old + os.sep):
            rule[key] = new + expanded[len(old):]
            changed = True
if changed:
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".migrate-", suffix=".json")
    with os.fdopen(fd, "w") as fh:
        json.dump(doc, fh, indent=2, ensure_ascii=False); fh.write("\n")
    os.chmod(tmp, 0o600); os.replace(tmp, path)
PY
  then
    rm -rf "$tmp"
    echo "$CLI: could not rewrite copied legacy rules; migration will be retried next time" >&2
    return 1
  fi
  find "$tmp" -type d -exec chmod 700 {} \; 2>/dev/null || true
  find "$tmp" -type f -exec chmod 600 {} \; 2>/dev/null || true
  if ! mv "$tmp" "$target"; then
    rm -rf "$tmp"
    echo "$CLI: could not finish legacy migration; it will be retried next time" >&2
    return 1
  fi
  info "copied legacy ~/.neo-mitm state into $target (the original was left unchanged)"
  if [ ! -f "$STATE_ROOT/current-project" ]; then   # neo-mitm users keep working on their rules without --project
    atomic_private_text "$STATE_ROOT/current-project" neo && info "current project: neo (change with: $CLI projects use ID)"
  fi
}

ensure_rules() {
  migrate_legacy
  secure_dirs
  [ -f "$RULES" ] && return
  local example="$PROJECT_PROFILE/rules.example.json"
  [ -f "$example" ] || die "rules example not found: $example"
  local tmp; tmp=$(mktemp "$PROJECT_STATE/.rules.XXXXXX") || die "cannot create temporary rules file"
  cp "$example" "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$RULES" || { rm -f "$tmp"; die "cannot create $RULES"; }
  info "created $RULES from project '$PROJECT' (all rules off)"
}

cmd_projects() {
  local action="${1:-list}"; shift || true
  case "$action" in
    list)
      /usr/bin/python3 -I - "$SCRIPT_DIR/projects" "$STATE_ROOT/profiles" "$PROJECT" <<'PY'
import json, os, sys
repo, user, current = sys.argv[1:]
items = {}
for root in (repo, user):
    if not os.path.isdir(root): continue
    for name in os.listdir(root):
        path = os.path.join(root, name, "project.json")
        if name.startswith("_") or not os.path.isfile(path): continue
        try:
            with open(path) as fh: doc = json.load(fh)
            items[name] = doc
        except (OSError, ValueError): pass
for name in sorted(items):
    doc = items[name]
    print("%s %-16s %-18s %s" % ("*" if name == current else " ", name, doc.get("label", name), doc.get("description", "")))
PY
      ;;
    use)
      [ $# -eq 1 ] || die "usage: $CLI projects use ID"
      valid_id "$1" || die "invalid project ID '$1'"
      profile_dir "$1" >/dev/null || die "unknown project '$1'"
      atomic_private_text "$STATE_ROOT/current-project" "$1" || die "could not save current project"
      info "current project: $1 (restart a running proxy to load its rules)"
      ;;
    show)
      local id="${1:-$PROJECT}" dir
      valid_id "$id" || die "invalid project ID '$id'"
      dir="$(profile_dir "$id")" || die "unknown project '$id'"
      /usr/bin/python3 -I -m json.tool "$dir/project.json"
      ;;
    new)
      [ $# -ge 1 ] || die "usage: $CLI projects new ID --label LABEL --hosts REGEX"
      local id="$1" label="" hosts=""; shift
      valid_id "$id" || die "invalid project ID '$id'"
      while [ $# -gt 0 ]; do case "$1" in
        --label) [ $# -ge 2 ] || die "--label needs a value"; label="$2"; shift ;;
        --hosts) [ $# -ge 2 ] || die "--hosts needs a value"; hosts="$2"; shift ;;
        *) die "projects new: unknown option $1" ;;
      esac; shift; done
      [ -n "$label" ] || die "projects new: --label is required"
      [ -n "$hosts" ] || die "projects new: --hosts is required"
      [ ! -e "$STATE_ROOT/profiles/$id" ] || die "user profile '$id' already exists"
      # R5A-06: the same safety check as every other user regex — this one runs on every call through the proxy
      local rx_err; rx_err=$(PYTHONPATH="$SCRIPT_DIR/addons" /usr/bin/python3 -I -c 'import sys; sys.path.insert(0, sys.argv[2])
import re
from proxy_common import user_regex
try: user_regex(sys.argv[1])
except re.error as e: print(e); sys.exit(1)' "$hosts" "$SCRIPT_DIR/addons" 2>&1) || die "invalid hosts regex: $rx_err"
      # R2A-09: the project filter compares the host WITHOUT its port, so "host:8443" would never match and "<project> only" stays empty
      /usr/bin/python3 -I -c 'import re,sys; sys.exit(1 if re.search(r":(\\d|[0-9])", sys.argv[1]) else 0)' "$hosts" 2>/dev/null || die "--hosts matches host names only, not ports: drop the ':port' (e.g. 'localhost' instead of 'localhost:3000')"
      local new_tmp="$STATE_ROOT/profiles/.$id.tmp.$$"
      (umask 077; mkdir -p "$STATE_ROOT/profiles"; mkdir "$new_tmp"; cp "$SCRIPT_DIR/projects/_template/rules.example.json" "$new_tmp/rules.example.json") || { rm -rf "$new_tmp"; die "could not create user profile '$id'"; }
      if ! /usr/bin/python3 -I - "$new_tmp/project.json" "$id" "$label" "$hosts" <<'PY'
import json, os, sys
path, ident, label, hosts = sys.argv[1:]
doc = {"id": ident, "label": label, "description": "User project profile", "hosts": hosts,
       "record_match": hosts, "throttle_match": hosts, "dev_ssl_insecure_hint":
       "use --insecure only when the upstream certificate cannot be validated",
       "android_packages": [], "ios_bundle_ids": []}
with open(path, "w") as fh: json.dump(doc, fh, indent=2); fh.write("\n")
os.chmod(path, 0o600)
rules = os.path.join(os.path.dirname(path), "rules.example.json")
with open(rules) as fh: cfg = json.load(fh)
cfg["throttle_match"] = hosts; cfg["collections"]["record_match"] = hosts
with open(rules, "w") as fh: json.dump(cfg, fh, indent=2); fh.write("\n")
os.chmod(rules, 0o600)
PY
      then rm -rf "$new_tmp"; die "could not create user profile '$id'"
      fi
      mv "$new_tmp" "$STATE_ROOT/profiles/$id" || { rm -rf "$new_tmp"; die "could not install user profile '$id'"; }
      info "created user profile $STATE_ROOT/profiles/$id"
      ;;
    *) die "usage: $CLI projects list|use ID|show [ID]|new ID --label LABEL --hosts REGEX" ;;
  esac
}

# ───────────────────────── start ─────────────────────────
# F-13: local capture must only ever name the Simulator or explicit apps. mitmproxy reads an empty spec as "every
# process" and "!name" as "everything except name" — either would capture this Mac's own traffic (mail, Teams, VPN).
check_capture_filter() {
  local spec="$1" item
  [ -n "$spec" ] || die "--ios-filter is empty: that would capture every app on this Mac. Name the Simulator or an app."
  case "$spec" in ,*|*,|*,,*) die "--ios-filter '$spec': an empty name between commas would match every app" ;; esac
  case "$spec" in *[!A-Za-z0-9\ ._,-]*) die "--ios-filter '$spec': only app/process names separated by commas (no '!' or patterns)" ;; esac
  local IFS=,
  for item in $spec; do
    item="${item# }"; item="${item% }"
    [ ${#item} -ge 3 ] || die "--ios-filter '$spec': each name needs at least 3 characters (a short name matches too many apps)"
  done
}

cmd_start() {
  local insecure=0 ios=1 filter="CoreSimulator" project_only=0 open_ui=1 show_all=0 private_hosts="" upstream="" upstream_set=0 bg=0 fwd=()
  local start_explicit="${RIVIS_START_PROJECT_EXPLICIT:-0}"
  [ -n "${RIVIS_START_PROJECT_EXPLICIT+x}" ] || { [ "$PROJECT_SOURCE" != argument ] || [ -n "${RIVIS_START_PROJECT_SOURCE:-}" ] || start_explicit=1; }
  local a; for a in "$@"; do [ "$a" = --background ] || fwd+=("$a"); done
  while [ $# -gt 0 ]; do case "$1" in
    --background) bg=1 ;;
    --insecure|--dev) insecure=1 ;; --no-ios) ios=0 ;; --ios-filter) [ $# -ge 2 ] || die "--ios-filter needs a value"; filter="$2"; shift ;;
    --allow-private-hosts) [ $# -ge 2 ] || die "--allow-private-hosts needs a regex"; private_hosts="$2"; shift ;;
    --upstream) [ $# -ge 2 ] || die "--upstream needs an http://host:port URL"; upstream="$2"; upstream_set=1; shift ;;
    --project-only|--neo-only) project_only=1 ;; --no-open) open_ui=0 ;; --all) show_all=1 ;;
    *) die "start: unknown option $1" ;; esac; shift; done
  [ "$ios" = 1 ] && check_capture_filter "$filter"
  [ -z "$private_hosts" ] || /usr/bin/python3 -I -c 'import re,sys; re.compile(sys.argv[1])' "$private_hosts" 2>/dev/null \
    || die "--allow-private-hosts needs a valid regex"
  [ "$upstream_set" = 1 ] || upstream=$(cat "$UPSTREAM_FILE" 2>/dev/null || echo direct)
  if [ -n "$upstream" ] && [ "$upstream" != direct ]; then
    /usr/bin/python3 -I -c 'import sys,urllib.parse
try:
 u=urllib.parse.urlsplit(sys.argv[1]); assert u.scheme=="http" and u.hostname and u.port and not u.username and not u.password and not u.path and not u.query and not u.fragment
except (AssertionError,ValueError): sys.exit(1)' "$upstream" || die "--upstream needs an http://host:port URL without credentials or path"
  fi
  # Android-only testers skip the Redirector in the installer; capturing the Simulator without it only brings up macOS
  # prompts. Start without it and say how to turn it on. (An unreadable extension list changes nothing.)
  if [ "$ios" = 1 ] && [ "$(uname)" = Darwin ]; then
    local ext; ext=$(systemextensionsctl list 2>/dev/null) || ext=""
    if [ -n "$ext" ] && ! printf '%s\n' "$ext" | grep 'org.mitmproxy.macos-redirector' | grep -q 'activated enabled'; then
      ios=0
      info "iOS Simulator capture is off: the Mitmproxy Redirector is not approved on this Mac (Android emulators, web apps and the proxy work)."
      info "  to capture the Simulator: approve it (re-run the installer, or System Settings → General → Login Items & Extensions → Network Extensions), then $CLI stop && $CLI start"
    fi
  fi
  command -v mitmweb >/dev/null || die "mitmweb not found (brew install --cask mitmproxy)"
  ensure_ca; ensure_rules
  # Already running (the installer offers to start it, then the quickstart says `start` again): say so, exit 0.
  if [ -n "$(our_listeners)" ]; then
    info "$PRODUCT_NAME is already running (proxy 127.0.0.1:$PORT, UI http://127.0.0.1:$WEB_PORT/)."
    warn_running_version # R4A-01: installed --version alone says nothing about a live old proxy.
    info "  open the UI: $CLI ui    ·    to start it with other options: $CLI stop, then $CLI start …"
    return 0
  fi
  # A second start must not replace the first process's UI token while mitmweb is still binding its ports.
  local start_guard="$STATE_ROOT/start-guard-$WEB_PORT" guard_pid=""
  if [ -z "${RIVIS_START_INTERNAL:-}" ]; then
    if ! mkdir "$start_guard" 2>/dev/null; then
      guard_pid=$(cat "$start_guard/pid" 2>/dev/null || true)
      if [ -z "$guard_pid" ] || kill -0 "$guard_pid" 2>/dev/null; then
        die "start already in progress on UI port $WEB_PORT; retry after it finishes"
      fi
      rm -rf "$start_guard"
      mkdir "$start_guard" 2>/dev/null || die "start already in progress on UI port $WEB_PORT"
    fi
    printf '%s\n' "$$" > "$start_guard/pid"
  fi
  local o free_hint="quit it, or start on free ports: ${ENV_PREFIX}_PORT=18080 ${ENV_PREFIX}_WEB_PORT=18083 $CLI start"
  o=$(port_owner "$PORT"); { [ -n "$o" ] || port_accepts "$PORT"; } && die "port $PORT already taken by another program: ${o:-listener not visible to this account} — $free_hint"
  o=$(port_owner "$WEB_PORT"); { [ -n "$o" ] || port_accepts "$WEB_PORT"; } && die "UI port $WEB_PORT already taken by another program: ${o:-listener not visible to this account} — $free_hint"
  [ "$upstream_set" = 0 ] || atomic_private_text "$UPSTREAM_FILE" "$upstream" || die "could not save upstream proxy setting"
  # how this instance was started, so an in-app update can restart it the same way (addons/update_install.sh)
  if [ -z "${RIVIS_START_INTERNAL:-}" ]; then
  { printf 'START_PORT=%q\nSTART_WEB_PORT=%q\nSTART_PROJECT_SOURCE=%q\nSTART_PROJECT_EXPLICIT=%q\nSTART_ARGS=(' "$PORT" "$WEB_PORT" "${RIVIS_START_PROJECT_SOURCE:-$PROJECT_SOURCE}" "$start_explicit"
    printf '%q ' --project "$PROJECT" start; [ "$bg" = 1 ] && printf '%q ' --background
    for a in ${fwd[@]+"${fwd[@]}"}; do printf '%q ' "$a"; done; [ "$open_ui" = 0 ] || printf '%q ' --no-open; printf ')\n'; } > "$START_FILE.tmp" \
    && chmod 600 "$START_FILE.tmp" && mv -f "$START_FILE.tmp" "$START_FILE"
  fi
  if [ "$bg" = 1 ]; then   # same start, detached from this terminal; output goes to a private log
    mkdir -p "$STATE_ROOT/logs"; local log="$STATE_ROOT/logs/mitmweb.log"
    rotate_log "$log"
    # R2A-14: line-buffered, so script log() lines show in the log while the proxy runs, not only after stop
    RIVIS_START_INTERNAL=1 RIVIS_START_PROJECT_SOURCE="${RIVIS_START_PROJECT_SOURCE:-$PROJECT_SOURCE}" RIVIS_START_PROJECT_EXPLICIT="$start_explicit" PYTHONUNBUFFERED=1 nohup "$0" --project "$PROJECT" start ${fwd[@]+"${fwd[@]}"} < /dev/null >> "$log" 2>&1 &
    local child=$! i; disown "$child" 2>/dev/null || true
    for i in $(seq 1 60); do [ -n "$(port_owner "$WEB_PORT")" ] && break; kill -0 "$child" 2>/dev/null || break; sleep 0.5; done
    [ -n "$(port_owner "$WEB_PORT")" ] || { tail -5 "$log" >&2; die "did not start — full log: $log"; }
    rmdir "$start_guard" 2>/dev/null || rm -rf "$start_guard"
    info "$PRODUCT_NAME is running in the background (proxy 127.0.0.1:$PORT, UI http://127.0.0.1:$WEB_PORT/)"
    info "devices  in the UI: Tools → Devices, one click per simulator / emulator (or: $CLI setup)"
    info "reopen the UI: $CLI ui   ·   stop: $CLI stop   ·   log: $log"
    return 0
  fi
  # UI login: one token per run (or the product-prefixed WEB_PASSWORD). We open the browser ourselves
  # WITH the token — mitmweb's own auto-open lands on a "403 Authentication Required" page.
  local token="${WEB_PASSWORD:-$(openssl rand -hex 16)}"
  atomic_private_text "$TOKEN_FILE" "$token" || die "could not save private UI password"
  local bootstrap; bootstrap=$(openssl rand -hex 16)
  atomic_private_text "$BOOTSTRAP_FILE" "$bootstrap" || die "could not save one-time UI login"
  local url="http://127.0.0.1:$WEB_PORT/"
  local bootstrap_url="http://127.0.0.1:$WEB_PORT/proxy/bootstrap/$bootstrap"
  local mode="regular@$PORT"
  [ -z "$upstream" ] || [ "$upstream" = direct ] || mode="upstream:$upstream@$PORT"
  local args=(--listen-host 127.0.0.1 --mode "$mode"
              --set web_host=127.0.0.1 --set "web_port=$WEB_PORT" --set web_open_browser=false
              --set confdir="$CONFDIR" --set connection_strategy=lazy
              # HTTP/1.1 to the app lets one app connection retain one reusable upstream connection. With HTTP/2,
              # app streams to an HTTP/1.1-only origin each open a new upstream TLS connection. That is especially
              # expensive for TLS 1.2 static-RSA gateways over a VPN. RIVIS_HTTP2=1 opts back in.
              --set "http2=$([ "$(env_value HTTP2 0)" = 1 ] && echo true || echo false)" --set "stream_large_bodies=$(env_value STREAM_LARGE_BODIES 64m)"
              -s "$AUTH_ADDON" -s "$ADDON" -s "$SCRIPT_DIR/addons/proxy_scripts.py" -s "$SCRIPT_DIR/addons/proxy_collections.py" -s "$SCRIPT_DIR/addons/proxy_source.py" -s "$SCRIPT_DIR/addons/proxy_panel.py" -s "$SCRIPT_DIR/addons/proxy_retention.py" -s "$SCRIPT_DIR/addons/proxy_operability.py"
              --set "proxy_auth_token_file=$TOKEN_FILE" --set "proxy_bootstrap_file=$BOOTSTRAP_FILE"
              --set "proxy_rules_file=$RULES" --set "proxy_project=$PROJECT" --set "proxy_max_flows=$MAX_FLOWS" --set "proxy_log_dir=$STATE_ROOT/logs")
  [ -n "$private_hosts" ] && args+=(--set "proxy_private_hosts=$private_hosts")
  # local capture: the iOS Simulator shares the Mac network stack and has no proxy
  # setting of its own. Scoping capture to simulator processes keeps us off the
  # system proxy (forbidden) and leaves every Mac app — Teams, browser, VPN — untouched.
  [ "$ios" = 1 ] && args+=(--mode "local:$filter")
  [ "$insecure" = 1 ] && args+=(--set ssl_insecure=true)
  # Upstream HTTPS is checked against what this Mac trusts (root store + roots IT/MDM or the user trusted), like Safari
  # and Proxyman. mitmproxy alone knows only its bundled list, so on a TLS-inspecting network every call failed.
  # RIVIS_EXTRA_TRUST=PEM[:PEM…] adds roots the keychain lacks; RIVIS_SYSTEM_TRUST=0 keeps mitmproxy's own list.
  if [ "$insecure" = 0 ] && [ "$(env_value SYSTEM_TRUST 1)" != 0 ]; then
    local trust_pem="$STATE_ROOT/upstream-trust.pem" extra_trust=() trust_counts _x
    local IFS_SAVE="$IFS"; IFS=:; for _x in $(env_value EXTRA_TRUST ""); do [ -f "$_x" ] && extra_trust+=("$_x"); done; IFS="$IFS_SAVE"
    if trust_counts=$(/usr/bin/python3 -I "$SCRIPT_DIR/addons/system_trust.py" "$trust_pem" ${extra_trust[@]+"${extra_trust[@]}"} 2>/dev/null); then
      args+=(--set "ssl_verify_upstream_trusted_ca=$trust_pem")
      [ "${trust_counts#* }" != 0 ] && info "upstream HTTPS: this Mac's trust store (${trust_counts#* } added root(s) from your organisation or keychain)"
    else
      info "upstream HTTPS: mitmproxy's own root list (this Mac's trust store could not be read)"
    fi
  fi
  # Simulator capture also grabs DNS/UDP — dozens of lookup rows that bury the API calls.
  # Default view = HTTP(S) requests only, like Proxyman. --all shows the raw stream.
  local view="~http"
  if [ "$project_only" = 1 ] && [ -n "$PROJECT_HOSTS" ]; then
    local escaped_hosts
    escaped_hosts=$(/usr/bin/python3 -I -c 'import sys; print(sys.argv[1].replace("\\", "\\\\").replace("'"'"'", "\\'"'"'"))' "$PROJECT_HOSTS")
    view="~http & (~d '$escaped_hosts')"
  fi
  [ "$show_all" = 1 ] && view=""
  [ -n "$view" ] && args+=(--set "view_filter=$view")
  info "proxy  127.0.0.1:$PORT   (Android emulator: 10.0.2.2:$PORT)"
  # Another tool (Proxyman, FRTMProxy) as system proxy = the simulator sends its traffic THERE;
  # local capture then only sees DNS rows. Seen 2026-10-14: Proxyman on :9091 stole every call.
  # A proxy app that quit (or crashed) often leaves the Mac's proxy on its dead loopback port: every Mac app and the
  # Simulator then lose the network. Clear exactly those leftovers on every start (2026-10-16, a tester's Mac).
  [ "$(uname)" = Darwin ] && cmd_net_reset --auto
  local sp; sp=$(scutil --proxy | awk '/HTTPSEnable/{e=$3} /HTTPSProxy/{h=$3} /HTTPSPort/{p=$3} END{if(e==1)print h":"p}')
  if [ "$ios" = 1 ] && [ -n "$sp" ]; then
    local who; who=$(port_owner "${sp##*:}" | awk '{print $1}')
    if [ -n "$who" ]; then
      echo "!! $who is your Mac's proxy ($sp): the iOS Simulator sends its traffic there, not to $PRODUCT_NAME." >&2
      echo "!! Check the Mac's proxy settings before expecting Simulator traffic in $PRODUCT_NAME; an unknown setting is never cleared automatically." >&2
    elif [[ "${sp##*:}" =~ ^[0-9]+$ ]] && port_accepts "${sp##*:}"; then
      echo "!! The Mac's proxy $sp accepts TCP connections, but its owner is not visible to this account — left alone. iOS Simulator traffic goes there." >&2
    else
      echo "!! WARNING: macOS system proxy is $sp — iOS Simulator traffic goes there, not to $PRODUCT_NAME." >&2
    fi
  fi
  [ "$ios" = 1 ] && info "iOS    local capture of processes matching '$filter' (no system proxy)"
  [ "$insecure" = 1 ] && info "TLS    upstream verification OFF"
  info "upstream proxy: ${upstream:-direct}"
  if [ "$show_all" = 1 ]; then info "view   everything (incl. DNS/UDP)"
  elif [ "$project_only" = 1 ]; then info "view   $PROJECT_LABEL HTTP calls only — everything else still proxied, just hidden"
  else info "view   HTTP(S) requests only (DNS lookups hidden; --all to show them)"; fi
  info "project $PROJECT ($PROJECT_LABEL)"
  info "rules  $RULES  ($CLI rules list)"
  info "UI     $url (opens signed in; the password is never printed)"
  info "       (reopen any time: $CLI ui)   — Ctrl-C to stop (or start with --background)"
  info "devices  in the UI: Tools → Devices, one click per simulator / emulator (or: $CLI setup)"
  if [ "$open_ui" = 1 ]; then
    ( for _ in $(seq 1 40); do [ -n "$(port_owner "$WEB_PORT")" ] && { open "$bootstrap_url"; break; }; sleep 0.25; done ) &
  fi
  exec mitmweb "${args[@]}"
}

our_mitmweb() {   # our_mitmweb PID — a mitmweb started from THIS state dir (never another HOME's or user's)
  ps -o comm= -p "$1" 2>/dev/null | grep -q mitmweb || return 1
  local args; args=$(ps -ww -o args= -p "$1" 2>/dev/null) || return 1
  case "$args" in *"web_port=$WEB_PORT "*) ;; *) return 1 ;; esac
  case "$args" in *"proxy_auth_token_file=$TOKEN_FILE "*) return 0 ;; esac
  # R4A-05: an older proxy on a nondefault port still used the shared file until restarted.
  [ "$WEB_PORT" = 8083 ] || case "$args" in *"proxy_auth_token_file=$STATE_ROOT/web-token "*) return 0 ;; esac
  return 1
}
running_tool_dir() { # R4A-01: read the actual add-on path, not the launcher or current symlink.
  ps -ww -o args= -p "$1" 2>/dev/null | /usr/bin/python3 -I -c 'import re,sys
prefix=re.escape(sys.argv[1])
for line in sys.stdin:
 m=re.search(r"(?:^|\s)-s\s+("+prefix+r"/tool-[^/\s]+/addons)/proxy_auth\.py(?:\s|$)",line)
 if m: print(m.group(1)); break' "$HOME/.local/$CLI"
}
warn_running_version() {
  local pid path version installed
  installed=$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || cat "$SCRIPT_DIR/install/VERSION" 2>/dev/null || echo dev)
  installed=$(echo "$installed" | tr -d '[:space:]')
  for pid in $(our_listeners); do
    path=$(running_tool_dir "$pid"); [ -n "$path" ] || continue
    version=${path%/addons}; version=${version##*/tool-}
    [ "$version" = "$installed" ] || echo "!! running pid $pid is $PRODUCT_NAME $version; installed is $installed — run $CLI restart" >&2
  done
}
# curl to this Rivis's own UI. Never through a proxy the shell exports (it would record the UI token in Rivis's own
# call list, or hand it to a corporate proxy: QA-07), and the URL with its token goes in a config read from stdin, not
# in argv, where `ps` shows it to every local user (R3-DATA-11).   ui_curl PATH [curl options…]
ui_curl() {
  local path="$1" tok sep="?"; shift
  # percent-encoded (a custom ${ENV_PREFIX}_WEB_PASSWORD may hold & " \ …); read from the file, never passed in argv
  tok=$(/usr/bin/python3 -I -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.stdin.read().strip(), safe=""))' \
        < "$TOKEN_FILE" 2>/dev/null) && [ -n "$tok" ] || return 1
  case "$path" in *\?*) sep="&" ;; esac
  printf 'url = "http://127.0.0.1:%s%s%stoken=%s"\n' "$WEB_PORT" "$path" "$sep" "$tok" | curl -sf --noproxy '*' -K - "$@"
}
# Rules and scripts load for the running project, which may differ from the selected project.
warn_running_project() {
  local running; running=$(ui_curl /proxy/api/state 2>/dev/null | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("active_project") or "")' 2>/dev/null) || return 0
  [ -z "$running" ] || [ "$running" = "$PROJECT" ] || echo "$CLI: warning: the running proxy serves project '$running', not '$PROJECT' — changes to '$PROJECT' apply only after: $CLI --project $PROJECT stop && $CLI --project $PROJECT start" >&2
  return 0
}
our_listeners() { local pid; for pid in $(lsof -t -iTCP:"$PORT" -iTCP:"$WEB_PORT" -sTCP:LISTEN 2>/dev/null | sort -u); do our_mitmweb "$pid" && echo "$pid"; done; true; }
# ───────────────────────── update ─────────────────────────
# Signed updates from the team's private GitHub releases (addons/updater.py: device-flow sign-in, Keychain, signature +
# SHA-256 checks). The install runs detached (addons/update_install.sh) because it stops and restarts this proxy.
cmd_update() {
  local U=(/usr/bin/python3 -I "$SCRIPT_DIR/addons/updater.py") action="${1:-check}" out yes=0
  [ "${2:-}" = --yes ] && yes=1
  case "$action" in
    login|logout) "${U[@]}" "$action" ;;
    status) "${U[@]}" status ;;
    check|install)
      out=$("${U[@]}" check) || die "$(printf '%s' "$out" | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("error","update check failed"))' 2>/dev/null). To upgrade, download the new release zip from https://github.com/CoorB/rivis/releases and run its install.sh."
      local v notes; v=$(printf '%s' "$out" | /usr/bin/python3 -I -c 'import json,sys; a=json.load(sys.stdin)["available"]; print(a["version"] if a else "")')
      if [ -z "$v" ]; then info "$PRODUCT_NAME $(printf '%s' "$out" | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin)["current"])') is up to date"; return 0; fi
      notes=$(printf '%s' "$out" | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin)["available"]["notes"])')
      info "$PRODUCT_NAME $v is available"; [ -n "$notes" ] && printf '%s\n' "$notes" | sed 's/^/    /'
      [ "$action" = install ] || [ -t 0 ] || return 0
      if [ "$action" = check ]; then printf 'Install it now? %s restarts by itself. [Y/n] ' "$PRODUCT_NAME"; read -r ans || ans=n
        case "$ans" in ""|y|Y|yes) ;; *) return 0 ;; esac; fi
      printf '%s' "$("${U[@]}" status)" | /usr/bin/python3 -I -c 'import json,sys; sys.exit(0 if json.load(sys.stdin)["installed"] else 1)' \
        || die "this copy runs from a source checkout — update it with git, not with '$CLI update'"
      out=$("${U[@]}" download) || die "$(printf '%s' "$out" | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("error","download failed"))' 2>/dev/null)"
      local zip; zip=$(printf '%s' "$out" | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin)["path"])')
      mkdir -p -m 700 "$STATE_ROOT/updates"
      nohup /bin/bash "$SCRIPT_DIR/addons/update_install.sh" "$zip" > "$STATE_ROOT/updates/install.log" 2>&1 < /dev/null &
      disown $! 2>/dev/null || true
      info "installing $PRODUCT_NAME $v in the background (verified: signature + SHA-256). It restarts by itself in about a minute."
      info "log: $STATE_ROOT/updates/install.log" ;;
    *) die "usage: $CLI update [check|install|login|logout|status]" ;;
  esac
}

warn_android_proxy_on_stop() {
  [ -x "$ADB" ] || return 0
  local s proxy matches=""
  for s in $("$ADB" devices 2>/dev/null | awk '/^emulator-[0-9]+[[:space:]]+device$/{print $1}'); do
    proxy=$("$ADB" -s "$s" shell settings get global http_proxy 2>/dev/null | tr -d '\r') || continue
    [ "$proxy" = "10.0.2.2:$PORT" ] && matches="$matches $s"
  done
  [ -z "$matches" ] || echo "$CLI: warning: emulator(s)$matches still use this proxy port; run '$CLI android off' to restore their network" >&2
  return 0
}
cmd_stop() {   # stop our mitmweb on our ports (only ours — never another app, HOME or user)
  local pids pid i other; pids=$(our_listeners)
  if [ -z "$pids" ]; then
    other=$(lsof -t -iTCP:"$PORT" -iTCP:"$WEB_PORT" -sTCP:LISTEN 2>/dev/null | sort -u | tr '\n' ' ')
    [ -n "$other" ] && info "ports $PORT/$WEB_PORT are held by another program or another $PRODUCT_NAME (pid $other) — not ours, left running" \
                    || info "nothing to stop on :$PORT/:$WEB_PORT"
    warn_android_proxy_on_stop
    return 0
  fi
  for pid in $pids; do kill "$pid" 2>/dev/null || true; done
  # SIGTERM is asynchronous.  Do not let `stop && start` race the old
  # listeners; give mitmweb time to flush, then bound shutdown with SIGKILL.
  for i in $(seq 1 100); do [ -z "$(our_listeners)" ] && break; sleep 0.1; done
  if [ -n "$(our_listeners)" ]; then
    for pid in $(our_listeners); do kill -9 "$pid" 2>/dev/null || true; done
    for i in $(seq 1 20); do [ -z "$(our_listeners)" ] && break; sleep 0.1; done
  fi
  [ -z "$(our_listeners)" ] || die "ports $PORT/$WEB_PORT are still in use after stopping mitmweb"
  # R4A-05: leave other web ports' credentials intact; an older instance on another port may still use the shared file
  if [ "$WEB_PORT" != 8083 ] || ! ps -axww -o args= 2>/dev/null | grep -qF "proxy_auth_token_file=$STATE_ROOT/web-token "; then
    rm -f "$TOKEN_FILE" "$BOOTSTRAP_FILE"
  fi
  rm -rf "$STATE_ROOT/start-guard-$WEB_PORT"
  info "stopped mitmweb on :$PORT/:$WEB_PORT"
  warn_android_proxy_on_stop
}

# health — is the instance on these ports really serving, and on the installed version? Used after every upgrade
# restart and rollback, so "restarted" is never claimed for a proxy that came up broken or on the wrong version.
cmd_health() {
  local bad=0 installed state running code
  installed=$(tr -d '[:space:]' < "$SCRIPT_DIR/VERSION" 2>/dev/null || tr -d '[:space:]' < "$SCRIPT_DIR/install/VERSION" 2>/dev/null)
  if [ -z "$(our_listeners)" ]; then echo "not running on :$PORT/:$WEB_PORT"; return 3; fi
  # R8D-01: any HTTP request to the proxy becomes a row in the tester's call list (and in saved evidence), so the
  # proxy port is checked with a bare TCP connection; the panel answering below proves the same process serves.
  if /usr/bin/python3 -I -c 'import socket,sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), 5).close()' "$PORT" 2>/dev/null
  then echo "proxy :$PORT        accepts connections"
  else echo "proxy :$PORT        DOES NOT ANSWER a test call"; bad=1; fi
  state=$(ui_curl /proxy/api/state --max-time 8 2>/dev/null) || state=""
  running=$(printf '%s' "$state" | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("version") or "")' 2>/dev/null)
  if [ -n "$running" ]; then echo "panel :$WEB_PORT      answers ($PRODUCT_NAME $running)"
  else echo "panel :$WEB_PORT      DOES NOT ANSWER"; bad=1; fi
  if [ -n "$running" ] && [ -n "$installed" ] && [ "$running" != "$installed" ]; then
    echo "version            running $running, installed $installed — run: $CLI restart"; bad=1
  fi
  if [ "$bad" = 0 ]; then echo "healthy"; return 0; fi
  echo "NOT healthy — to go back to the version you had before: $CLI rollback"; return 1
}

# rollback — switch to an earlier installed version (the installer keeps each version in its own tool-<version> folder)
# and restart this instance with its saved start, then check it. Never deletes a version.
cmd_rollback() {
  local root="$HOME/.local/$CLI" cur target list arg="${1:-}"
  # Any installed version folder may run this (also a newer one while an older is current: 0.9.6 has no rollback
  # command, so going forward again is  ~/.local/<cli>/tool-<new>/<cli> rollback <new>).
  [ -L "$root/current" ] && case "$SCRIPT_DIR" in "$(cd "$root" 2>/dev/null && pwd -P)"/tool-*) true ;; *) false ;; esac \
    || die "this copy is not an installed one ($SCRIPT_DIR) — rollback switches installed versions only"
  cur=$(tr -d '[:space:]' < "$root/current/VERSION" 2>/dev/null)
  list=$(for d in "$root"/tool-*; do [ -x "$d/$CLI" ] && printf '%s\n' "${d##*/tool-}"; done |
         /usr/bin/python3 -I -c 'import sys,re
vs=[l.strip() for l in sys.stdin if l.strip()]
key=lambda v: [int(x) if x.isdigit() else x for x in re.split(r"[.-]", v)]
print("\n".join(sorted(vs, key=key)))')
  if [ "$arg" = --list ] || [ "$arg" = list ]; then
    printf '%s\n' "$list" | while read -r v; do [ -n "$v" ] && echo "$v$([ "$v" = "$cur" ] && echo '   ← current')"; done; return 0
  fi
  if [ -n "$arg" ]; then target="$arg"
  else target=$(printf '%s\n' "$list" | awk -v c="$cur" '$0==c{print p; exit} {p=$0}'); fi
  [ -n "$target" ] || die "no earlier version is installed (installed: $(printf '%s' "$list" | tr '\n' ' ')) — reinstall the older installer zip instead"
  [ "$target" != "$cur" ] || die "$PRODUCT_NAME $cur is already the current version"
  [ -x "$root/tool-$target/$CLI" ] || die "$PRODUCT_NAME $target is not installed (installed: $(printf '%s' "$list" | tr '\n' ' '))"
  local was_running=""; [ -n "$(our_listeners)" ] && was_running=1
  START_PORT=""; START_WEB_PORT=""; START_PROJECT_SOURCE=""; START_PROJECT_EXPLICIT=0; START_ARGS=()
  if [ -n "$was_running" ]; then
    [ -f "$START_FILE" ] && . "$START_FILE"
    [ ${#START_ARGS[@]} -gt 0 ] || START_ARGS=(start --background --no-open)
    cmd_stop || return
  fi
  ln -sfn "$root/tool-$target" "$root/current" || die "could not switch to $target"
  info "switched $cur → $target"
  grep -q '^cmd_rollback()' "$root/tool-$target/$CLI" 2>/dev/null \
    || info "$PRODUCT_NAME $target has no rollback command; to come back to $cur later run: $root/tool-$cur/$CLI rollback $cur"
  if [ -z "$was_running" ]; then info "it was not running — start it with: $CLI start"; return 0; fi
  RIVIS_START_PROJECT_SOURCE="${START_PROJECT_SOURCE:-legacy}" RIVIS_START_PROJECT_EXPLICIT="$START_PROJECT_EXPLICIT" \
    "$root/current/$CLI" "${START_ARGS[@]}" || die "could not start $target — run: $CLI start (or $CLI rollback $cur to undo)"
  local i; for i in $(seq 1 20); do "$root/current/$CLI" health >/dev/null 2>&1 && break; sleep 0.5; done
  if "$root/current/$CLI" health >/dev/null 2>&1; then info "$PRODUCT_NAME $target is running and healthy"
  else
    # an older version may not have the health command: check the ports directly
    [ -n "$(our_listeners)" ] && info "$PRODUCT_NAME $target is running on :$PORT/:$WEB_PORT" \
      || die "$target did not come up on :$PORT/:$WEB_PORT — run: $CLI rollback $cur to undo"
  fi
}

cmd_restart() { # R4A-01: replay saved project and flags after an upgrade, for this web port only.
  START_PORT=""; START_WEB_PORT=""; START_PROJECT_SOURCE=""; START_PROJECT_EXPLICIT=0; START_ARGS=()
  [ -f "$START_FILE" ] || die "no saved start for :$WEB_PORT — run $CLI start with the desired options"
  . "$START_FILE"
  [ "$START_PORT" = "$PORT" ] && [ "$START_WEB_PORT" = "$WEB_PORT" ] && [ ${#START_ARGS[@]} -gt 0 ] \
    || die "saved start does not match :$PORT/:$WEB_PORT — run $CLI start with the desired options"
  # A normal start follows `projects use`; an explicit --project start keeps its chosen project.
  case "$START_PROJECT_SOURCE" in
    default|current-project|legacy|argument)
      if [ "$START_PROJECT_EXPLICIT" != 1 ] && [ "${START_ARGS[0]:-}" = --project ]; then START_ARGS[1]="$PROJECT"; fi ;;
  esac
  cmd_stop || return
  [ -z "$(port_owner "$PORT")$(port_owner "$WEB_PORT")" ] \
    || die "ports $PORT/$WEB_PORT are held by another program — stop it or choose other ports; nothing was restarted"
  RIVIS_START_PROJECT_SOURCE="$START_PROJECT_SOURCE" RIVIS_START_PROJECT_EXPLICIT="$START_PROJECT_EXPLICIT" "$0" "${START_ARGS[@]}"
}

cmd_ui() {
  [ -n "$(port_owner "$WEB_PORT")" ] || die "mitmweb is not running — $CLI start"
  [ -f "$TOKEN_FILE" ] || die "no token file — restart with $CLI start"
  local bootstrap
  bootstrap=$(openssl rand -hex 16) || die "could not generate a one-time UI login"
  atomic_private_text "$BOOTSTRAP_FILE" "$bootstrap" || die "could not save one-time UI login"
  open "http://127.0.0.1:$WEB_PORT/proxy/bootstrap/$bootstrap"
}

# browser — a separate Chrome/Edge window for web apps (HTTP Toolkit / Proxyman's "open a browser with the proxy").
# Its own profile under $STATE_ROOT/browser, pointed at our proxy, trusting ONLY this CA (by public-key pin) — the
# user's normal browser, the macOS system proxy and the keychain are never touched.
browser_bin() {   # browser_bin ID — path of that browser's executable, or nothing
  local id="$1" entry name dir
  for entry in "chrome:Google Chrome" "edge:Microsoft Edge" "chromium:Chromium" "brave:Brave Browser"; do
    [ "${entry%%:*}" = "$id" ] || continue
    name="${entry#*:}"
    local IFS=:
    for dir in $(env_value BROWSER_APPS "/Applications:$HOME/Applications"); do
      [ -x "$dir/$name.app/Contents/MacOS/$name" ] && { printf '%s' "$dir/$name.app/Contents/MacOS/$name"; return 0; }
    done
  done
  return 1
}
browser_list() { local entry; for entry in "chrome:Google Chrome" "edge:Microsoft Edge" "chromium:Chromium" "brave:Brave Browser"; do
  browser_bin "${entry%%:*}" >/dev/null && printf '%s\t%s\n' "${entry%%:*}" "${entry#*:}"; done; true; }
current_tab() {   # prints "<app>\t<url>" of the front tab of the first running browser (AppleScript; reads only)
  local app script out
  for app in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium" "Safari"; do
    [ "$(osascript -e "application \"$app\" is running" 2>/dev/null)" = true ] || continue
    if [ "$app" = Safari ]; then script="tell application \"Safari\" to get URL of front document"
    else script="tell application \"$app\" to get URL of active tab of front window"; fi
    if out=$(osascript -e "$script" 2>&1); then printf '%s\t%s\n' "$app" "$out"; return 0; fi
    case "$out" in
      *-1743*|*"Not authorized"*) die "browser: macOS did not let Terminal read $app's tab. Allow it in System Settings → Privacy & Security → Automation (your terminal app → $app), then run this again" ;;
      *-1728*|*-1719*) die "browser: $app has no open window" ;;
    esac
    die "browser: could not read the current tab of $app: $out"
  done
  die "browser: --current needs Chrome, Edge, Brave, Chromium or Safari running with a page open"
}
# Delete leftover --fresh profiles, except one a browser is still running on (its --user-data-dir shows in ps).
browser_sweep_fresh() {
  local d running; running=$(ps -axo command= 2>/dev/null)
  for d in "$@"; do
    [ -d "$d" ] && [ ! -L "$d" ] && [ -O "$d" ] || continue
    printf '%s\n' "$running" | grep -qF -- "--user-data-dir=$d" && continue
    rm -rf "$d"
  done
}

cmd_browser() {
  local id="" url="about:blank" fresh=0 list=0 current=0 bin profile spki pid
  while [ $# -gt 0 ]; do
    case "$1" in
      --browser) [ $# -ge 2 ] || die "browser: --browser needs chrome, edge, chromium or brave"; id="$2"; shift ;;
      --chrome|--edge|--chromium|--brave) id="${1#--}" ;;
      --fresh) fresh=1 ;;
      --list) list=1 ;;
      --current) current=1 ;;
      -*) die "browser: unknown option $1" ;;
      *) [ "$url" = "about:blank" ] || die "browser: only one URL"
         url="$1"
         # a bare host (or host:port) gets https://; any other scheme (javascript:, file:, data:) is refused
         [[ "$url" == *://* ]] || { [[ "$url" =~ ^[A-Za-z][A-Za-z0-9+.-]*:([^0-9]|$) ]] || url="https://$url"; }
         [[ "$url" =~ ^https?://[^[:space:]]+$ ]] || die "browser: '$1' is not an http(s) URL" ;;
    esac
    shift
  done
  if [ "$list" = 1 ]; then browser_list; return 0; fi
  if [ "$current" = 1 ]; then
    [ "$url" = "about:blank" ] || die "browser: give a URL or --current, not both"
    local tab from; tab=$(current_tab) || exit 1
    from="${tab%%$'\t'*}"; url="${tab#*$'\t'}"
    [[ "$url" =~ ^https?://[^[:space:]]+$ ]] || die "browser: the front tab of $from is not a web page ($url)"
    info "the front tab of $from: $url"
    if [ -z "$id" ]; then   # open it in the same browser it came from (Safari: the first one installed below)
      case "$from" in "Google Chrome") id=chrome ;; "Microsoft Edge") id=edge ;; "Brave Browser") id=brave ;; Chromium) id=chromium ;; esac
      [ -z "$id" ] || browser_bin "$id" >/dev/null || id=""
    fi
  fi
  if [ -n "$id" ]; then
    case "$id" in chrome|edge|chromium|brave) ;; *) die "browser: unknown browser '$id' (chrome, edge, chromium or brave)" ;; esac
    bin=$(browser_bin "$id") || die "browser: $id is not installed (looked in $(env_value BROWSER_APPS "/Applications:$HOME/Applications"))"
  else
    id=$(browser_list | awk -F'\t' 'NR==1{print $1}')
    [ -n "$id" ] || die "browser: no Chrome, Edge, Chromium or Brave found in /Applications (Firefox is not supported yet)"
    bin=$(browser_bin "$id")
  fi
  pid=$(lsof -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1)
  [ -n "$pid" ] || die "$PRODUCT_NAME is not running on :$PORT — $CLI start"
  our_mitmweb "$pid" || die "port $PORT is held by $(port_owner "$PORT"), not by this $PRODUCT_NAME — the browser would not be captured"
  ensure_ca
  spki=$(openssl x509 -in "$CA_PEM" -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64) \
    && [ -n "$spki" ] || die "browser: could not read the CA's public key"
  if [ "$fresh" = 1 ]; then
    (umask 077; mkdir -p "$STATE_ROOT/browser") || die "browser: could not create $STATE_ROOT/browser"
    chmod 700 "$STATE_ROOT/browser" 2>/dev/null || true
    browser_sweep_fresh "$STATE_ROOT/browser"/tmp-* "${TMPDIR:-/tmp}/$CLI-browser."*   # earlier --fresh profiles (cookies, logins)
    profile=$(umask 077; mktemp -d "$STATE_ROOT/browser/tmp-XXXXXX") || die "browser: could not create a temporary profile"
  else
    profile="$STATE_ROOT/browser/$id"
    (umask 077; mkdir -p "$profile") || die "browser: could not create $profile"
    chmod 700 "$STATE_ROOT/browser" "$profile" 2>/dev/null || true
  fi
  # Web apps on localhost go through Rivis only when this Rivis allows them (start --allow-private-hosts): by default
  # it refuses private destinations, so the browser reaches localhost directly, as usual (review R8). The Rivis UI
  # itself always stays direct (it would record itself).
  local bypass="127.0.0.1:$WEB_PORT;localhost:$WEB_PORT" loopback=0 allowed=""
  allowed=$(ui_curl /options --max-time 5 | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin)["proxy_private_hosts"]["value"])' 2>/dev/null)
  if [ -n "$allowed" ] && /usr/bin/python3 -I -c 'import re,sys; sys.exit(0 if all(re.fullmatch(sys.argv[1], h) for h in ("localhost", "127.0.0.1")) else 1)' "$allowed" 2>/dev/null; then
    bypass="<-loopback>;$bypass"; loopback=1
  fi
  local flags=(--user-data-dir="$profile" --proxy-server="127.0.0.1:$PORT"
    --proxy-bypass-list="$bypass"
    --ignore-certificate-errors-spki-list="$spki" --use-mock-keychain
    --no-first-run --no-default-browser-check --disable-sync)
  nohup "$bin" "${flags[@]}" "$url" </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
  info "opened ${bin##*/} with its own $PRODUCT_NAME profile → proxy 127.0.0.1:$PORT"
  info "profile $profile$( [ "$fresh" = 1 ] && echo " (temporary)" )"
  info "your normal browser, the system proxy and the keychain are not touched; close that window when done"
  if [ "$loopback" = 0 ] && [[ "$url" =~ ^https?://(localhost|127\.0\.0\.1)([:/]|$) ]]; then
    info "localhost opens directly, not through $PRODUCT_NAME (it blocks private addresses unless told otherwise). To capture it:"
    info "  $CLI stop && $CLI start --allow-private-hosts '^(localhost|127\.0\.0\.1)\$'   then run this again"
  fi
}

