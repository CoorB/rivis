{
  "schema_version": 1,
  "throttle": "3g-urban",
  "throttle_match": ".",
  "loss": 0,
  "tls": {
    "mode": "all",
    "allow": [],
    "ignore": []
  },
  "manual": {
    "latency_ms": 0,
    "jitter_ms": 0,
    "down_kbps": 0,
    "up_kbps": 0,
    "loss_pct": 0,
    "response_delay_ms": 0
  },
  "rules": [
    {
      "name": "keepme",
      "enabled": true,
      "match": "/keep",
      "action": "set_header",
      "side": "request",
      "header": "X-Keep",
      "value": "1"
    },
    {
      "name": "card",
      "enabled": true,
      "match": "/card",
      "action": "map_local",
      "file": "__HOME__/.rivis/projects/default/mocks/card.json"
    }
  ],
  "scripts": [
    {
      "name": "hdr",
      "file": "hdr.py",
      "lang": "py",
      "enabled": true,
      "match": ".",
      "method": null
    }
  ],
  "breakpoints": [
    {
      "name": "login",
      "match": "/login",
      "method": null,
      "request": true,
      "response": true,
      "enabled": true
    }
  ],
  "collections": {
    "recording": null,
    "record_match": ".",
    "replay": [
      "journey"
    ],
    "strict": false
  }
}
